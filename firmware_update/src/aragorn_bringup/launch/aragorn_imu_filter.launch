
<launch>
    <node pkg="imu_calib" type="apply_calib" name="apply_calib1" output="screen" respawn="false">
        <param name="calib_file" value="$(find aragorn_bringup)/param/imu/imu_calib.yaml" />
        <param name="calibrate_gyros" value="true" />
        <remap from="raw" to="/imu/data_raw"/>
        <remap from="corrected" to="/imu/calibrated"/>
    </node>

    <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu_filter_madgwick1" output="screen" respawn="false" >
            <param name="fixed_frame" value="base_footprint" />
            <param name="use_mag" value="false" />
            <param name="publish_tf" value="false" />
            <param name="use_magnetic_field_msg" value="true" /> 
            <param name="world_frame" value="enu" />
            <param name="orientation_stddev" value="0.05" />
            <remap from="/imu/data_raw" to="/imu/calibrated"/>
            <remap from="/imu/data" to="/imu/data" />
        </node>
    
    <node pkg="imu_complementary_filter" type="complementary_filter_node"
      name="complementary_filter_gain_node" output="screen">
        <param name="do_bias_estimation" value="true"/>
        <param name="do_adaptive_gain" value="true"/>
        <param name="use_mag" value="false"/>
        <param name="gain_acc" value="0.01"/>
        <param name="gain_mag" value="0.01"/>
        <remap from="imu/data" to="imu/data_complementart"/>
  
    </node>
</launch>