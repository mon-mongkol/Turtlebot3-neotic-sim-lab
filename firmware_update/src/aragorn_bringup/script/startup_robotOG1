#!/usr/bin/env python2
# -*- coding: utf-8 -*-

import rospy, roslaunch
import numpy as np
import rospkg
import subprocess
import os
import sys
from enum import Enum
from std_msgs.msg import UInt8, Bool, Int8

import actionlib
from actionlib_msgs.msg import *


from ir_auto_docking.msg import AutodockOperateAction
from web_interface_msgs.msg import DockingAction
from web_interface_msgs.msg import RouteFollowAction
from mission_msgs.msg import MissionOperateAction
from mission_msgs.msg import MissionRunAction
from move_base_msgs.msg import MoveBaseAction
from aragorn_io_action.msg import ScanMotionAction
from aragorn_io_action.msg import UVCAction





class CoreNodeController():
    def __init__(self):
        self.ros_package_path = os.path.dirname(os.path.realpath(__file__))
        self.ros_package_path = self.ros_package_path.replace('aragorn_bringup/script', '')

        self.rospack = rospkg.RosPack()

        # self.sub_start_up = rospy.Subscriber('/aragorn_io/diagnostics', Bool, self.cbStartRobot, queue_size=1)
        self.sub_mode = rospy.Subscriber('/aragorn/robot_mode', Int8, self.cbModeLaunch, queue_size=1)
        # self.sub_emer = rospy.Subscriber('/aragorn_io/emergency', Int8, self.cbEmer, queue_size=1)

        self.Launcher = Enum('Launcher', 'launch_vel_filter launch_sound launch_motor launch_imu launch_bms launch_camera launch_rear_camera launch_io launch_io_action launch_remote launch_core launch_lidar launch_lidar_unique launch_diagnostics launch_led launch_web launch_localization')
        self.CurrentMode = Enum('CurrentMode', 'idle start_motor shutdown_motor shutdown_robot emergency fucn_1 down_stairs tablet_loss_commu uvc_on uvc_off ready_to_start docking_mode_on docking_mode_off error_device charger_on charger_off reset')

        self.uuid = roslaunch.rlutil.get_or_generate_uuid(None, False)
        
        self.move_base = actionlib.SimpleActionClient("move_base", MoveBaseAction)
        
        # self.MoveBase = actionlib.SimpleActionClient("move_base", MoveBaseAction)
        self.IR_Docking = actionlib.SimpleActionClient("autodocking_server", AutodockOperateAction)
        self.IST_Docking = actionlib.SimpleActionClient("ist_docking", DockingAction)
        self.IST_RouteFollow = actionlib.SimpleActionClient("ist_route_follow", RouteFollowAction)
        self.IST_Mission_server = actionlib.SimpleActionClient("missions_server", MissionRunAction)
        self.IST_Mission_operate = actionlib.SimpleActionClient("missions_operate", MissionOperateAction)
        self.ScanMotion = actionlib.SimpleActionClient("scan_motion_server", ScanMotionAction)
        self.UVC = actionlib.SimpleActionClient("uvc_server", UVCAction)
        

        self.launch_motor_launched = False
        self.launch_vel_filter_launched = False
        self.launch_sound_launched = False
        self.launch_io_launched = False
        self.launch_io_action_launched = False
        self.launch_bms_launched = False
        self.launch_imu_launched = False
        self.launch_camera_launched = False
        self.launch_rear_camera_launched = False
        self.launch_remote_launched = False
        self.launch_core_launched = False
        self.launch_lidar_launched = False
        self.launch_diagnostics_launched = False
        self.launch_led_launched = False
        self.launch_web_launched = False
        self.launch_localization_launched = False
        self.launch_lidar_unique_launched = False

        self.is_triggered = False

        self.current_mode = self.CurrentMode.idle.value

        self.serial_no = os.environ["MATRIX_UVD_SERIAL_NO"]
        self.model_type = self.serial_no[8]

        self.remote_launch = ""

        self.initial_robot()

        loop_rate = rospy.Rate(10) # 10hz
        while not rospy.is_shutdown():
            if self.is_triggered == True:
                self.fnControlNode()
            
            loop_rate.sleep()
    
    # def emergency_case(self):
    #     self.MoveBase.cancel_all_goals()
    #     self.IR_Docking.cancel_all_goals()
    #     self.IST_Docking.cancel_all_goals()
    #     self.IST_RouteFollow.cancel_all_goals()
    #     self.IST_Mission_server.cancel_all_goals()
    #     self.IST_Mission_operate.cancel_all_goals()
    #     self.ScanMotion.cancel_all_goals()
    #     self.UVC.cancel_all_goals()

    def cbModeLaunch(self, mode_msg):
        # rospy.loginfo("Start core_controller with mode %d", mode_msg)
        if(self.current_mode == mode_msg.data):
            pass
        else:
            self.current_mode = mode_msg.data
            self.is_triggered = True
    
    def initial_robot(self):
        # os.system("killall -9 roslaunch")
        # os.system("killall -9 rosout")
        # os.system("killall -9 rosmaster")
        # rospy.sleep(2)
        
        # select tf robot 
        if self.model_type == "B":
            self.remote_launch = "/launch/include/tf/tf_"+ self.serial_no + ".launch"
        else:
            # model A common tf
            self.remote_launch = "/launch/aragorn_remote.launch"
        self.fnLaunch(self.Launcher.launch_remote.value, True)

        # select configure lidar 
        if self.serial_no == "20210001B":
            self.fnLaunch(self.Launcher.launch_lidar_unique.value, True)
        else:
            self.fnLaunch(self.Launcher.launch_lidar.value, True)

        self.fnLaunch(self.Launcher.launch_camera.value, True)
        self.fnLaunch(self.Launcher.launch_bms.value, True)
        self.fnLaunch(self.Launcher.launch_imu.value, True)
        self.fnLaunch(self.Launcher.launch_io.value, True)
        self.fnLaunch(self.Launcher.launch_io_action.value, True)
        self.fnLaunch(self.Launcher.launch_localization.value, True)
        self.fnLaunch(self.Launcher.launch_sound.value, True)
        self.fnLaunch(self.Launcher.launch_diagnostics.value, True)
        rospy.sleep(10)
        # self.fnLaunch(self.Launcher.launch_led.value, True)
        self.fnLaunch(self.Launcher.launch_vel_filter.value, True)


    
    def fnControlNode(self):
        # Start_robot mode
        if self.current_mode == self.CurrentMode.start_motor.value:
            rospy.loginfo("[Launch control]: Now trigger for Start motor drive")
            self.fnLaunch(self.Launcher.launch_io_action.value, True)
            self.fnLaunch(self.Launcher.launch_motor.value, True)
            
            # rospy.sleep(5)
            # self.fnLaunch(self.Launcher.launch_localization.value, True)
        elif self.current_mode == self.CurrentMode.reset.value:
            rospy.loginfo("[Launch control]: Now trigger for reset io state and off motor control")
            self.fnLaunch(self.Launcher.launch_motor.value, False)
            self.fnLaunch(self.Launcher.launch_io_action.value, False)
        
        elif self.current_mode == self.CurrentMode.emergency.value:
            rospy.loginfo("[Launch control]: Now trigger for Stop motor drive")
            # self.fnLaunch(self.Launcher.launch_localization.value, False)
            # rospy.sleep(5)
            self.fnLaunch(self.Launcher.launch_motor.value, False)
            
            
            self.move_base.cancel_all_goals()
            self.IR_Docking.cancel_all_goals()
            self.IST_Docking.cancel_all_goals()
            self.IST_RouteFollow.cancel_all_goals()
            self.IST_Mission_server.cancel_all_goals()
            self.IST_Mission_operate.cancel_all_goals()
            self.ScanMotion.cancel_all_goals()
            self.UVC.cancel_all_goals()

            self.fnLaunch(self.Launcher.launch_io_action.value, False)

            # a = subprocess.run(["rosservice", "call", "/aragorn_io/led_status"])
	
	    # elif self.current_mode == self.CurrentMode.fucn_1.value:
        #     rospy.loginfo("[Launch control]: Now trigger for Relocalization")
        #     self.fnLaunch(self.Launcher.launch_localization.value, False)
        #     rospy.sleep(5)
        #     self.fnLaunch(self.Launcher.launch_localization.value, True)
        
        elif self.current_mode == self.CurrentMode.down_stairs.value:
            rospy.loginfo("[Launch control]: Now trigger for Down stairs")
            self.fnLaunch(self.Launcher.launch_motor.value, False)
        
        elif self.current_mode == self.CurrentMode.tablet_loss_commu.value:
            rospy.loginfo("[Launch control]: Now trigger for Tablet loss comunicate")
            self.fnLaunch(self.Launcher.launch_motor.value, False)

        
        # Off_robot mode
        elif self.current_mode == self.CurrentMode.shutdown_robot.value:
            rospy.loginfo("Now trigger for shutdown Robot")
            self.fnLaunch(self.Launcher.launch_localization.value, False)
            self.fnLaunch(self.Launcher.launch_remote.value, False)
            self.fnLaunch(self.Launcher.launch_lidar.value, False)
            self.fnLaunch(self.Launcher.launch_core.value, False)
        
        self.is_triggered = False

    def fnLaunch(self, launch_num, is_start):
        if launch_num == self.Launcher.launch_lidar_unique.value:
            if is_start == True:
                if self.launch_lidar_unique_launched == False:
                    self.launch_lidar_unique = roslaunch.scriptapi.ROSLaunch()
                    self.launch_lidar_unique = roslaunch.parent.ROSLaunchParent(self.uuid, [self.rospack.get_path('aragorn_bringup') + "/launch/aragorn_lidar_filter_unique.launch"])
                    self.launch_lidar_unique_launched = True
                    self.launch_lidar_unique.start()
                else:
                    pass
            else:
                if self.launch_lidar_unique_launched == True:
                    self.launch_lidar_unique_launched = False
                    self.launch_lidar_unique.shutdown()
                else:
                    pass

        if launch_num == self.Launcher.launch_motor.value:
            if is_start == True:
                if self.launch_motor_launched == False:
                    self.launch_motor = roslaunch.scriptapi.ROSLaunch()
