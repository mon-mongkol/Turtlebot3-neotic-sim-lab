                    self.launch_motor_launched = True
                    self.launch_motor.start()
                else:
                    pass
            else:
                if self.launch_motor_launched == True:
                    self.launch_motor_launched = False
                    self.launch_motor.shutdown()
                else:
                    pass
        
        if launch_num == self.Launcher.launch_sound.value:
