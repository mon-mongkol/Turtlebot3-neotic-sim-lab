<?xml version="1.0"?>
<launch>
  <!-- <arg name="port" default="/dev/matrix_rgb_camera" /> -->
  <arg name="port" default="/dev/matrix_rgb_camera" />
  <node pkg="uvc_camera" type="uvc_camera_node" name="uvc_camera" output="screen" ns="uvc_cam_rear">
        <!--<param name="width" type="int" value="320" />
        <param name="height" type="int" value="240" />
        <param name="frame" type="string" value="wide_stereo" />
        <param name="fps" type="int" value="30" /> -->

        <param name="auto_focus" type="bool" value="False" /> 
        <!-- <param name="focus_absolute" type="int" value="0" /> -->
        <!-- other supported params: auto_exposure, exposure_absolute, brightness, power_line_frequency -->
        <param name="format" value="MJPG" />
        <!-- <param name="device" type="string" value="/dev/matrix_rgb_camera" /> -->
        <param name="device" type="string" value="$(arg port)" />
        <param name="vertical_flip" type="bool" value="false" />
        <param name="frame_id" type="string" value="camera_rear_link" />
        <!-- <param name="camera_info_url" type="string" value="file://$(find matrix_amr_bringup)/launch/include/common_device/camera_rear/camera_info_$(env camera_rear_model).yaml" /> -->
        <param name="camera_info_url" type="string" value="file://$(find matrix_amr_bringup)/param/$(env sub_model)/$(env serial_no)/rear_camera_info/$(env camera_rear_model)_info.yaml" />
  </node>
</launch>