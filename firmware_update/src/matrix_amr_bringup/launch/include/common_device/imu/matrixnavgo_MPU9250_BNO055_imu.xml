<?xml version="1.0"?>
<launch>
    <arg name="port" default="/dev/ttyUSB0" />
    <arg name="bringup_matrix_controller" default="false" />

    <group if="$(eval bringup_matrix_controller == 'false')">
        <node pkg="rosserial_python" name="matrix_navgo_controller" type="serial_node.py" output="screen">
            <param name="port" value="$(arg port)" />
            <param name="baud" value="57600" />
        </node>
    </group>


    <!-- IMU relay from linorobot_msgs/Imu to sensor_msgs/Imu use lino_imu_calib-->
    <node pkg="lino_imu_calib" type="apply_calib" name="apply_calib" output="screen" respawn="false">
        <param name="calib_file" value="$(find matrix_amr_bringup)/param/$(env sub_model)/$(env serial_no)/imu/imu_cfg_$(env serial_no).yaml" />
        <param name="calibrate_gyros" value="true" />
        <remap from="raw_imu" to="matrix_controller/raw_imu"/>
        <param name="serial_no" value="$(env serial_no)"/>
    </node>

    <!-- Filter and fuse raw imu data -->
    <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu_filter_madgwick" output="screen" respawn="false" >
        <param name="fixed_frame" value="base_footprint" />
        <param name="use_mag" value="true" />
        <param name="publish_tf" value="false" />
        <param name="use_magnetic_field_msg" value="true" /> 
        <param name="world_frame" value="enu" />
        <param name="orientation_stddev" value="0.05" />
    </node>
</launch>