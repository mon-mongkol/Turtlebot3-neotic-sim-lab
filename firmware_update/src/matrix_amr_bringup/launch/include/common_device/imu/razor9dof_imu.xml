<?xml version="1.0"?>
<launch>
        <arg name="port" default="/dev/ttyUSB0" />
        <!-- Razor-IMU -->
        <arg name="razor_config_file" default="$(find matrix_amr_bringup)/param/$(env sub_model)/$(env serial_no)/imu/imu_cfg_$(env serial_no).yaml"/>
        <node pkg="razor_imu_9dof" type="imu_node.py" name="imu_node" output="screen" respawn="true">
            <rosparam file="$(arg razor_config_file)" command="load"/>
        </node>

        <!-- <node pkg="imu_calib" type="apply_calib" name="apply_calib1" output="screen" respawn="false">
            <param name="calib_file" value="$(find smr_bringup)/param/imu/imu_calib.yaml" />
            <param name="calibrate_gyros" value="true" />
            <remap from="raw" to="razor_imu/data_raw"/>
            <remap from="corrected" to="razor_imu/calibrated"/>
        </node> -->

        <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu_filter_madgwick1" output="screen" respawn="false" >
            <param name="fixed_frame" value="base_footprint" />
            <param name="use_mag" value="false" />
            <param name="publish_tf" value="false" />
            <param name="use_magnetic_field_msg" value="true" /> 
            <param name="world_frame" value="enu" />
            <param name="orientation_stddev" value="0.05" />
            <remap from="/imu/data_raw" to="razor_imu/data_raw"/>
            <remap from="/imu/data" to="razor_imu/data" />
        </node>
</launch>