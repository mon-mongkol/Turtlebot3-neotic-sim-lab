<?xml version="1.0"?>
<launch>
    <arg name="port" default="/dev/ttyUSB0" />
    
    <arg name="param_path" default="$(find matrix_amr_bringup)/param/$(env sub_model)/$(env serial_no)/motor_driver/zlac8015d_$(env hw_ver).yaml"/>

    <node pkg="matrix_canopen_motor" type="driver" name="matrix_canopen_motor_driver" output="screen" >
        <rosparam command="load" file="$(arg param_path)" />
    </node>

    <arg name="node_start_delay" default="1.0" />  
    <node name="socketcan_bridge_node" pkg="socketcan_bridge" type="socketcan_bridge_node" launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@' " >
        <rosparam command="load" file="$(arg param_path)" />
    </node>

    <arg name="node_start_delay_odom" default="1.3" /> 
    <node pkg="matrix_canopen_motor" type="odom" name="matrix_canopen_motor_odom" launch-prefix="bash -c 'sleep $(arg node_start_delay_odom); $0 $@' " output="screen" >
        <rosparam command="load" file="$(arg param_path)" />
        <remap from="/matrix_canopen_motor/ZLAC8015D/odom" to="/raw_odom"/>
    </node>

</launch>