<?xml version="1.0"?>
<launch>

    <arg name="port" default="/dev/ttyUSB0"/>
    <arg name="tcp_ip" default="192.168.1.111"/>
    <arg name="tcp_port" default="520"/>

    <node pkg="matrix_handle_material" type="matrix_tm5_status" name="matrix_tm5_status" output="screen">
        <rosparam file="$(find matrix_handle_material)/param/mtrix_material_state.yaml"/>
        <param name="port" value="$(arg port)"/>
        <param name="tcp_ip" value="$(arg tcp_ip)"/>
        <param name="tcp_port" value="$(arg tcp_port)"/>
    </node>

    <node pkg="matrix_handle_material" type="matrix_tm5_operation_5box_modern" name="matrix_material_operation_server" output="screen">
        <param name="port" value="$(arg port)"/>
        <param name="tcp_ip" value="$(arg tcp_ip)"/>
        <param name="tcp_port" value="$(arg tcp_port)"/>
    </node>

</launch>