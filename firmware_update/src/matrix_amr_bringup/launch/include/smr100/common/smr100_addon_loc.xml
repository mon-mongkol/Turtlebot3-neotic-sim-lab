<?xml version="1.0"?>
<launch>
    <!-- Publish Linorobot odometry -->



    <arg name="sub_model" default="$(env hw_ver)"/>
    <group if="$(eval sub_model == 'smr100R')">
      
      <node pkg="linorobot" name="lino_base_node" type="lino_base_node">
        <remap from="/raw_vel" to="/matrix_controller/raw_vel"/>
      </node>

    </group>
</launch>