<launch>

    <arg name="port" default="$(env mcu01_port)"/>
    <arg name="sub_model" default="$(env hw_ver)"/>

    <group if="$(eval sub_model == 'smr100A')">
      
      <include file="$(find matrix_amr_bringup)/launch/include/common_device/motor/matrix_navgo_controller.xml" >
        <arg name="port" default="$(arg port)"/>
      </include>

    </group>

</launch>