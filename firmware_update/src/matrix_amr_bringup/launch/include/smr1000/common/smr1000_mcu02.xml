   
<launch>   
    <arg name="port" default="/dev/ttyUSB0" />
    <node pkg="rosserial_python" type="serial_node.py" name="matrix_mcu01" output="screen" >
        <param name="port" value="$(arg port)"/>
        <param name="baud" value="57600"/>
    </node>

    <node pkg="matrix_sonar_publisher" type="sonar_publisher" name="matrix_sonar_publisher" output="screen">
    </node>

</launch>