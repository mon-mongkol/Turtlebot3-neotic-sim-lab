<launch>
    
    <arg name="port" default="$(env mcu02_port)"/>
    <include file="$(find matrix_amr_bringup)/launch/include/$(env sub_model)/common/$(env sub_model)_mcu02.xml" >
      <arg name="port" default="/dev/$(arg port)"/>
    </include>

