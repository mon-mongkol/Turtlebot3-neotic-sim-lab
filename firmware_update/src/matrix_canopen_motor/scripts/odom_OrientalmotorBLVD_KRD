    def callback_reset_odom(self, req):
        if req.data:
            self.x = 0.0
            self.y = 0.0
            self.th = 0.0

            self.vx = 0.00
            self.vy = 0.00
            self.vth = 0.00

            self.current_time = rospy.Time.now()
            self.last_time = rospy.Time.now()


            self.m1read = False
            self.m2read = False
            self.m1 = 0.00
            self.m2 = 0.00
        return True, "odom reset success!!!"
    
    def get_rpm(self):
        counter_timeout = 0
        while True:
            
            try:
                # print("check bus receive")
                message = self.bus.recv(0.1)
                # message = rospy.wait_for_message('/received_messages', Frame, timeout=1)
                # print(message)

                self.motor_1_id_cfg = 0
                self.motor_2_id_cfg = 0
                self.motor_1_sub_index = 0
                self.motor_1_sub_index = 0
                self.actual_speed_index = [0x00, 0x00]
                self.motor_1_data_index = [0x00, 0x00]
                self.motor_2_data_index = [0x00, 0x00]


                if self.device_name == "ZLAC8015D":
                    self.motor_1_id_cfg = self.dual_driver_motor
                    self.motor_2_id_cfg = self.dual_driver_motor
                    self.motor_1_sub_index = self.motor_1_id
                    self.motor_2_sub_index = self.motor_2_id
                    self.actual_speed_index[0] = 0x6c
                    self.actual_speed_index[1] = 0x60
                    self.motor_1_data_index[0] = 4 
                    self.motor_1_data_index[1] = 5
                    self.motor_2_data_index[0] = 4 
                    self.motor_2_data_index[1] = 5
                else:
                    self.motor_1_id_cfg = self.motor_1_id
                    self.motor_2_id_cfg = self.motor_2_id
                    self.motor_1_sub_index = 0x00
                    self.motor_2_sub_index = 0x00
                    self.actual_speed_index[0] = 0x6c
                    self.actual_speed_index[1] = 0x60
                    self.motor_1_data_index[0] = 4 
                    self.motor_1_data_index[1] = 5
                    self.motor_2_data_index[0] = 4 
                    self.motor_2_data_index[1] = 5


                if not self.m1read:
                    if message.arbitration_id == (0x580 + self.motor_1_id_cfg):
                        # print("found 582")
                        if((message.data[0] == 0x43) and (message.data[1] == 0x6c) and (message.data[2] == 0x60) and (message.data[3] ==  self.motor_1_sub_index)):
                            self.m1 = bytearray([message.data[4], message.data[5]])
                            self.m1 = unpack('<h', self.m1)
                            # print("self.m1 {}".format(self.m1[0]/20.00))
                            self.m1 = (self.m1[0]/self.gear_ratio) * self.velocity_unit_rpm
                            self.m1read = True
                           
                    else:
                        pass
                else:
                    pass
                
                if not self.m2read:
                    if message.arbitration_id == (0x580 + self.motor_2_id_cfg):
                        # print("found 582")
                        if((message.data[0] == 0x43) and (message.data[1] == 0x6c) and (message.data[2] == 0x60) and (message.data[3] == self.motor_2_sub_index)):
                            self.m2 = bytearray([message.data[4], message.data[5]])
                            self.m2 = unpack('<h', self.m2)
                            # print("self.m1 {}".format(self.m1[0]/20.00))
                            self.m2 = (self.m2[0]/self.gear_ratio) * self.velocity_unit_rpm
                            self.m2read = True
                    
                    else:
                        pass
                else:
                    pass

                # print("check timeout get rpm")
            except:
                rospy.logerr("please check keya odom")
                # close program
                # sys.exit(1)     
                self.m1 = 0.00
                self.m2 = 0.00  
                self.m1read = True
                self.m2read = True
                # break
            
            # print(int(self.m1), int(self.m2))
            
            if self.m1read and self.m2read:
                self.m1read = False
                self.m2read = False
                # print(int(self.m1), int(self.m2))
                # print("111111111")
                return self.m1, self.m2
                self.m1 = 0.00
                self.m2 = 0.00
                break
            else:
                counter_timeout +=1
                if counter_timeout >= 6:
                    return self.m1, self.m2
                    break
    
    def getVelocities(self, rpm1, rpm2):
        avg_rps_x = ((float)(rpm1-rpm2) / self.total_wheels_) / 60.000 
        vel_x = avg_rps_x * self.wheel_circumference_

        vel_y = 0.0

        avg_rps_a = ((float)(rpm1 + rpm2) / self.total_wheels_) / 60.000 
        # print("{}".format(avg_rps_a))
        ang_z = (avg_rps_a * self.wheel_circumference_) / ((self.wheels_x_distance_ / 2) + (self.wheels_y_distance_ /2 ))
        ang_z = -ang_z

        # print(-vel_x, vel_y, ang_z)
        return vel_x, vel_y, ang_z

    def calculateOdom(self):
        rpm_1 = 0.00
        rpm_2 = 0.00
        rpm_m1, rpm_m2 = self.get_rpm()
        # print("--------")
        
        self.vx, self.vy, self.vth = self.getVelocities(rpm_m1, rpm_m2)
        # print("finish get robot vel {} {}".format(self.vx, self.vth))

        self.current_time = rospy.Time.now()

        # compute odometry in a typical way given the velocities of the robot
        dt = (self.current_time - self.last_time).to_sec()
        delta_x = (self.vx * cos(self.th) - self.vy * sin(self.th)) * dt
        delta_y = (self.vx * sin(self.th) + self.vy * cos(self.th)) * dt

        self.use_imu = False

        if self.use_imu:
            delta_th = self.current_theta - self.last_theta
            self.last_theta = self.current_theta
            self.vth = delta_th / dt
            
        else:
            delta_th = self.vth * dt

        self.x += delta_x
        self.y += delta_y
        self.th += delta_th

        # print(self.th)

        

        # since all odometry is 6DOF we'll need a quaternion created from yaw
        odom_quat = tf.transformations.quaternion_from_euler(0, 0, self.th)

        self.publish_tf = False
        # first, we'll publish the transform over tf
        if(self.publish_tf):
            self.odom_broadcaster.sendTransform(
                (self.x, self.y, 0.),
                odom_quat,
                self.current_time,
                self.base_frame,
                self.odom_frame
            )
        else:
            pass

        # next, we'll publish the odometry message over ROS
        odom = Odometry()
        odom.header.stamp = self.current_time
        odom.header.frame_id = self.odom_frame

        # set the position
        odom.pose.pose = Pose(Point(self.x, self.y, 0.), Quaternion(*odom_quat))

        # set the velocity
        odom.child_frame_id = self.base_frame
        odom.twist.twist = Twist(Vector3(self.vx, self.vy, 0), Vector3(0, 0, self.vth))

        # publish the message
        self.odom_pub.publish(odom)

        pose2d = Pose2D()
        pose2d.x = self.x
        pose2d.y = self.y
        pose2d.theta = self.vth

        self.last_time = self.current_time
        
   
if __name__ == '__main__':
    UpdateOdom()
    rospy.spin()