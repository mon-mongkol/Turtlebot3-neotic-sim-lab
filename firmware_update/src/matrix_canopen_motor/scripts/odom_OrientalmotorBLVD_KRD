class UpdateOdom:
    def __init__(self):
        
        self.node_name = "keya_odometry"
        rospy.init_node(self.node_name)

        # canbus read param
        if not rospy.has_param("~device_name"):
            rospy.set_param("~device_name", "OrientalmotorBLVD_KRD") 
        if not rospy.has_param("~dual_driver_motor"):
            rospy.set_param("~dual_driver_motor", False) 
        if not rospy.has_param("~use_matrix_navgo_bypass"):
            rospy.set_param("~use_matrix_navgo_bypass", False)
        if not rospy.has_param("~can_device"):
            rospy.set_param("~can_device", "can0")
        if not rospy.has_param("~canbus_bitrate"):
            rospy.set_param("~canbus_bitrate", 500000)
        if not rospy.has_param("~dual_motor_id"):
            rospy.set_param("~dual_motor_id", 1)
        if not rospy.has_param("~motor_1_id"):
            rospy.set_param("~motor_1_id", 1)
        if not rospy.has_param("~motor_2_id"):
            rospy.set_param("~motor_2_id", 2)
        if not rospy.has_param("~accel_time"):
            rospy.set_param("~accel_time", 100)
        if not rospy.has_param("~decel_time"):
            rospy.set_param("~decel_time", 100)
        if not rospy.has_param("~velocity_unit_rpm"):
            rospy.set_param("~velocity_unit_rpm", 1)
        self.device_name = rospy.get_param("~device_name")
        self.dual_driver_motor = rospy.get_param("~dual_driver_motor")
        self.use_matrix_navgo_bypass = rospy.get_param("~use_matrix_navgo_bypass")
        self.can_device = rospy.get_param("~can_device")
        self.can_bitrate = rospy.get_param("~canbus_bitrate")
        self.dual_motor_id = rospy.get_param("~dual_motor_id")
        self.motor_1_id = rospy.get_param("~motor_1_id")
        self.motor_2_id = rospy.get_param("~motor_2_id")
        self.accel_time = rospy.get_param("~accel_time")
        self.decel_time = rospy.get_param("~decel_time")
        self.velocity_unit_rpm = rospy.get_param("~velocity_unit_rpm")

        
        # odometry calculation param 
        if not rospy.has_param("~wheels_x_distance"):
            rospy.set_param("~wheels_x_distance", 0.0)
        if not rospy.has_param("~wheels_y_distance"):
            rospy.set_param("~wheels_y_distance", 0.481)
        if not rospy.has_param("~wheel_diameter"):
            rospy.set_param("~wheel_diameter", 0.151)
        if not rospy.has_param("~max_motor_rpm"):
            rospy.set_param("~max_motor_rpm", 3000.0)
        if not rospy.has_param("~gear_ratio"):
            rospy.set_param("~gear_ratio", 20.00)
        if not rospy.has_param("~total_wheels"):
            rospy.set_param("~total_wheels", 2.0)
        self.wheels_x_distance_ = rospy.get_param("~wheels_x_distance")
        self.wheels_y_distance_ = rospy.get_param("~wheels_y_distance")
        self.wheel_diameter = rospy.get_param("~wheel_diameter")
        self.max_motor_rpm = rospy.get_param("~max_motor_rpm")
        self.gear_ratio = rospy.get_param("~gear_ratio")
        self.total_wheels_ = rospy.get_param("~total_wheels")
        


        # odometry publisher param  
        if not rospy.has_param("~publish_tf"):
            rospy.set_param("~publish_tf", True)
        if not rospy.has_param("~base_frame"):
            rospy.set_param("~base_frame", "base_footprint") 
        if not rospy.has_param("~odom_frame"):
            rospy.set_param("~odom_frame", "odom")
        self.odom_frame = rospy.get_param("~odom_frame")
        self.base_frame = rospy.get_param("~base_frame")
        self.publish_tf = rospy.get_param("~publish_tf")



        # use IMU 
        if not rospy.has_param("~use_imu"):
            rospy.set_param("~use_imu", True) 
        if not rospy.has_param("~imu_topic"):
            rospy.set_param("~imu_topic", "/razor_imu/data") 
        self.use_imu = rospy.get_param("~use_imu")
        self.imu_topic = rospy.get_param("~imu_topic")

        
        self.wheel_circumference_ = math.pi * self.wheel_diameter

        self.x = 0.0
        self.y = 0.0
        self.th = 0.0

        self.vx = 0.00
        self.vy = 0.00
        self.vth = 0.00

        self.current_time = rospy.Time.now()
        self.last_time = rospy.Time.now()
        self.message = Frame()


        self.m1read = False
        self.m2read = False
        self.m1 = 0.00
        self.m2 = 0.00
        self.m1_actual_speed = 0.0
        self.m2_actual_speed = 0.0

        self.current_theta = 0.0
        self.last_theta = 0.0
        

        # can setup parameter
        # time.sleep(5)
        
        if not self.use_matrix_navgo_bypass:
            self.pub_can_sent = rospy.Publisher("/sent_messages", Frame, queue_size=10)
            self.sub_can_receive = rospy.Subscriber("/received_messages", Frame, self.can_recv_callback)
            # self.init_canbus(self.can_device, str(self.can_bitrate))
            try:
                self.bus = can.Bus(interface='socketcan',
                                    channel=self.can_device,
                                    receive_own_messages=False,
                                    bitrate=self.can_bitrate)
            except:
                print("[matrix_CanOpenMotor_orientalBLVD-KRD]: cansocket name {} not found.please check list network interfaces".format(self.can_device))
                os.system('ifconfig')
                sys.exit(0)
        else:
            # self.sub_can_receive = rospy.Subscriber("/matrix_io/canbus_send", Frame, queue_size=10)
            self.sub_can_receive = rospy.Subscriber("/matrix_io/canbus_receive", Frame, self.can_recv_callback)

        
        self.odom_pub = rospy.Publisher("matrix_canopen_motor/" + self.device_name + "/odom", Odometry, queue_size=1)
        self.odom_broadcaster = tf.TransformBroadcaster()
        # self.sub_imu = rospy.Subscriber(self.imu_topic, Imu, self.callback_imu)
        self.reset_service = rospy.Service("matrix_canopen_motor/" + self.device_name + "/reset_odom", SetBool, self.callback_reset_odom)

        rate = rospy.Rate(100)
        
        while not rospy.is_shutdown():
            # print("cal odom!!")
            self.calculateOdom()

            # print("spped m1 {},  m2 {}".format(self.m1_actual_speed, self.m2_actual_speed))
            rate.sleep()
    
    def callback_imu(self, imu_msg):
        global roll, pitch, yaw
        orientation_q = imu_msg.orientation
        orientation_list = [orientation_q.x, orientation_q.y, orientation_q.z, orientation_q.w]
        (roll, pitch, yaw) = tf.transformations.euler_from_quaternion (orientation_list)
        self.current_theta = yaw
        # print(self.current_theta)
    
