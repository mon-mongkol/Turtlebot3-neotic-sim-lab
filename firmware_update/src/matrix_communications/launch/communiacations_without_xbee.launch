<launch>

    <arg name="serial_no" default="$(env serial_no)"/>

    <node name="matrix_communications_xbee" pkg="serial_xbee" type="serial_Xbee_node" output="screen">
        <param name="serial_no" value="$(arg serial_no)"/>
    </node>

    <node name="matrix_communications_xbee_rohm_action" pkg="matrix_communications" type="xbee_movement_ROHM_action" output="screen">
        <!-- <remap from="/xbee_receive" to="/read"/> -->
        <param name="serial_no" value="$(arg serial_no)"/>
    </node>

    <!-- <node name="matrix_communications_central" pkg="matrix_communications" type="testoop" output="screen">
    </node> -->

    <!-- <node name="matrix_communications_xbee_rohm" pkg="matrix_communications" type="xbee_movement_ROHM_sub" output="screen">
    </node> -->

    
</launch>