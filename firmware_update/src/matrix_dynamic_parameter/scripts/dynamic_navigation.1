	# print(self.old_set_cost_scaling_factor)
        
        
                
    
    def update_costmap(self):
	
        if self.isTrigger == True:
            # set dynamic costmap
            print("[dyanmics_nav_param]: Trigger zone:", self.current_zone)
            self.local_costmap_dynamics_client.update_configuration({"cost_scaling_factor":self.set_local_scaling_factor,
                                                               "inflation_radius":self.set_local_inflation_radius})
            self.global_costmap_dynamics_client.update_configuration({"cost_scaling_factor":self.set_global_scaling_factor,
                                                               "inflation_radius":self.set_global_inflation_radius})
            
            # set param max velocity planner 
            self.Teb_dyc.update_configuration({"max_vel_x":self.set_teb_vel_planner})

            # set param move_base
            # self.move_base_dyc.update_configuration({"planner_frequency":self.set_planner_frequency})
            
            # enable / disable ultrasonic costmap 
            self.global_sonar_dyc.update_configuration({"enabled":self.enable_ultrasonic})
            self.local_sonar_dyc.update_configuration({"enabled":self.enable_ultrasonic})

            # enable / disable rgbd_layer
            # self.local_rgbd_layer_dyc.update_configuration( {
            #                                                 "enabled":self.enable_local_rgbd, 
            #                                                 "mark_threshold":self.set_local_mark_threshold, 
            #                                                 "voxel_decay":self.set_local_decay_voxel
            #                                                 })
            
            self.global_rgbd_layer_dyc.update_configuration( {
                                                            "enabled":self.enable_global_rgbd, 
                                                            "mark_threshold":self.set_global_mark_threshold, 
                                                            "voxel_decay":self.set_global_decay_voxel
                                                            })


            

            self.isTrigger = False
            print("complete set param")
            print(" ")
        else:
            pass


if __name__ == '__main__':
    rospy.init_node('dynamic_params')
