        # rospy.loginfo('[matrix_dynamic_parameter]:' + " ")

        try:
            m = alsaaudio.Mixer()
            if req.func == 0:
                rospy.loginfo('[matrix_dynamic_parameter]:' +
                              "[matrix_dynamic_parameter]:Service request current audio level")
                pass
            elif req.func == 1:
                rospy.loginfo('[matrix_dynamic_parameter]:' +
                              "[matrix_dynamic_parameter]:Service request change audio level")
                in_min = 0
                in_max = 100
                out_min = 50
                out_max = 100
                val_set = (req.arg0 - in_min) * (out_max -
                                                 out_min) / (in_max - in_min) + out_min
                m.setvolume(val_set)

            current_vol = int(m.getvolume())
            current_vol_cal = int(current_vol[0])
            in_min = 50
            in_max = 100
            out_min = 0
            out_max = 100
            current_vol_result = (current_vol_cal - in_min) * \
                (out_max - out_min) / (in_max - in_min) + out_min
            rospy.loginfo('[matrix_dynamic_parameter]:' + " ")
        except:
            pass
        return current_vol_result

