                self.local_rgbd_layer_dyc = dynamic_reconfigure.client.Client(
                    "/move_base/local_costmap/rgbd_obstacle_layer", config_callback=self.local_rgbd_callback)
                self.global_rgbd_layer_dyc = dynamic_reconfigure.client.Client(
                    "/move_base/global_costmap/rgbd_obstacle_layer", config_callback=self.global_rgbd_callback)
        except:
            rospy.logwarn(
                "[matrix_dynamics_navigation]:cannot setup rgbd_obstacle_layer")

        print(rospy.has_param('~orange_zone_vel'))

        self.orange_zone_vel = rospy.set_param('~orange_zone_vel', 0.2)
        self.yellow_zone_vel = rospy.set_param('~yellow_zone_vel', 0.4)
        self.green_zone_vel = rospy.set_param('~green_zone_vel', 1.2)
        self.room_zone_vel = rospy.set_param('~room_zone_vel', 0.5)
        self.no_zone_vel = rospy.set_param('~no_zone_vel', 0.7)

        print(self.orange_zone_vel)

        self.srv = Server(MatrixDynamicsNavigationConfig, self.callback)

        # # get robot model
        # try:
        #     self.robot_model = os.environ['model']
        # except:
        #     self.robot_model = "uvc"

        # # get serial no. of robot
        # try:
        #     self.robot_selno = os.environ['serial_no']
        # except:
        #     self.robot_selno = os.environ['MATRIX_UVD_SERIAL_NO']

        # self.r = rospy.sleep(0.1)
        r = rospy.Rate(10)

        while not rospy.is_shutdown():
            self.update_parameters()
            try:
                self.update_parameters()
            except:
                pass
            r.sleep()

    def callback(self, config, level):
        rospy.loginfo("get requestrtttt")
        # self.orange_zone_vel = 0.2
        # self.yellow_zone_vel = 0.4
        # self.green_zone_vel = 1.2
        # self.room_zone_vel = 0.5
        # self.no_zone_vel = 1.0
        print(config.orange_zone_vel)

        self.orange_zone_vel = config.orange_zone_vel
        self.yellow_zone_vel = config.yellow_zone_vel
        self.green_zone_vel = config.green_zone_vel
        self.room_zone_vel = config.room_zone_vel
        self.no_zone_vel = config.no_zone_vel
        # config.no_zone_vel = self.no_zone_vel

        if (not self.init_dynamics):
            # config.local_3d_obstacle = self.usr_local_layer["3d_obstacle"]
            get3dObstacleState_gb = self.global_rgbd_layer_dyc.get_configuration(
                timeout=None)
            get3dObstacleState_lc = self.local_rgbd_layer_dyc.get_configuration(
                timeout=None)
            if get3dObstacleState_gb["enabled"] or get3dObstacleState_lc["enabled"]:
                config.global_3d_obstacle = True
            else:
                config.global_3d_obstacle = False
            self.init_dynamics = True

        self.usr_local_layer["ist_prohibition"] = config.local_ist_prohibition
        self.usr_local_layer["static_map"] = config.local_static_map
        self.usr_local_layer["ultrasonic"] = config.local_ultrasonic
        self.usr_local_layer["2d_obstacle"] = config.local_2d_obstacle
        self.usr_local_layer["3d_obstacle"] = config.local_3d_obstacle

        self.usr_global_layer["ist_prohibition"] = config.global_ist_prohibition
        self.usr_global_layer["static_map"] = config.global_static_map
        self.usr_global_layer["ultrasonic"] = config.global_ultrasonic
        self.usr_global_layer["2d_obstacle"] = config.global_2d_obstacle
        self.usr_global_layer["3d_obstacle"] = config.global_3d_obstacle

        self.update_nav_layer()

        get3dObstacleState_gb = self.global_rgbd_layer_dyc.get_configuration(
            timeout=None)
        get3dObstacleState_lc = self.local_rgbd_layer_dyc.get_configuration(
            timeout=None)
        if get3dObstacleState_gb["enabled"] or get3dObstacleState_lc["enabled"]:
            config.global_3d_obstacle = True
        else:
            config.global_3d_obstacle = False

        return config

