    def cbZone(self, msg):
        # self.old_zone = self.old_zone
        self.current_zone = msg.zone_id
        for x in msg.zones:
            # check zone priority
            if x <= self.current_zone:
                self.current_zone = x
        # docking, yellow
        # if self.current_zone != self.old_zone:
        # print(msg.zone_id)
        # near zone
        if self.current_zone == 19:
            # # inflation
            # self.set_global_inflation_radius = 1.5  # 1.0
            # self.set_global_scaling_factor = 5.0   # 10.0

            # self.set_local_inflation_radius = 1.5  # 0.55
            # self.set_local_scaling_factor = 5.0 # 10.0

            # sonar
            self.enable_ultrasonic = False

            # move_base param
            self.set_layout_vel = self.orange_zone_vel
            self.set_planner_frequency = 0.0

            # #rgbd
            self.enable_local_rgbd = False
            # self.set_global_decay_voxel = 7.0
            # self.set_global_mark_threshold = 2.0

            self.enable_global_rgbd = False
            # self.set_local_decay_voxel = 0.5
            # self.set_local_mark_threshold = 2.0

            # self.enable_static_map = False

        elif self.current_zone == 18:  # yellow zone
            # self.set_global_inflation_radius = 1.5  # 1.0
            # self.set_global_scaling_factor = 5.0   # 10.0

            # self.set_local_inflation_radius = 1.5 # 0.45
            # self.set_local_scaling_factor = 5.0  # 10.0

            self.enable_ultrasonic = True
            self.set_layout_vel = self.yellow_zone_vel
            # self.enable_local_rgbd = True
            self.set_planner_frequency = 0.0

            # rgbd
            self.enable_local_rgbd = True
            # self.set_global_decay_voxel = 3.0
            # self.set_global_mark_threshold = 3.5

            self.enable_global_rgbd = True
            # self.set_local_decay_voxel = 1.0
            # self.set_local_mark_threshold = 3.5
            # self.enable_static_map = True

        elif self.current_zone == 17:  # green zone
            # self.set_global_inflation_radius = 1.5  # 1.0
            # self.set_global_scaling_factor = 5.0   # 10.0

            # self.set_local_inflation_radius = 1.5 # 0.45
            # self.set_local_scaling_factor = 5.0  # 10.0

            self.enable_ultrasonic = True
            self.set_layout_vel = self.green_zone_vel
            # self.enable_local_rgbd = True
            self.set_planner_frequency = 0.0

            # #rgbd
            self.enable_local_rgbd = True
            # self.set_global_decay_voxel = 3.0
            # self.set_global_mark_threshold = 3.5

            self.enable_global_rgbd = True
            # self.set_local_decay_voxel = 1.0
            # self.set_local_mark_threshold = 3.5
            # self.enable_static_map = True

        # costmap in room
        elif self.current_zone == 10:
            # self.set_global_inflation_radius = 1.5  # 1.0
            # self.set_global_scaling_factor = 5.0   # 10.0

            # self.set_local_inflation_radius = 1.5 # 0.45
            # self.set_local_scaling_factor = 5.0  # 10.0

            self.enable_ultrasonic = True
            self.set_layout_vel = self.room_zone_vel
            # self.enable_local_rgbd = True
            self.set_planner_frequency = 0.0

            # #rgbd
            self.enable_local_rgbd = True
            # self.set_global_decay_voxel = 3.0
            # self.set_global_mark_threshold = 3.5

            self.enable_global_rgbd = True
            # self.set_local_decay_voxel = 1.0
            # self.set_local_mark_threshold = 3.5
            # self.enable_static_map = True

        else:
            #    pass
            self.enable_ultrasonic = True
            self.set_layout_vel = self.no_zone_vel

            self.set_planner_frequency = 0.0

            self.enable_local_rgbd = True

            self.enable_global_rgbd = True

        # if self.set_global_inflation_radius != self.old_set_cost_scaling_factor:
        #     self.isTrigger = True
        #     self.old_set_cost_scaling_factor = self.set_global_inflation_radius
        #     # print("[dynamic_zone]: change zone costmap")
        #     # print("isTrigger", self.isTrigger)
        # else:
        #     #self.isTrigger = False
        #     pass
        # if self.current_zone != self.old_zone:
        #     self.isTrigger = True
        #     self.old_zone = self.current_zone
        # else:
        #     pass

    def update_parameters(self):
        try:

            getStatePlanner = self.planner_vel_dyc.get_configuration(
                timeout=None)

            getLocalCostmap = self.local_costmap_dynamics_client.get_configuration(
                timeout=None)
            getGlobalCostmap = self.global_costmap_dynamics_client.get_configuration(
                timeout=None)

            self.vel_user = rospy.wait_for_message("/gui_layout_map", UIMap)
            # print(self.vel_user.move_speed)

            if self.robot_model == 'uvc':
                self.uvc_state = rospy.wait_for_message(
                    "/aragorn_io/uvc_state", Int8)
                getGlobalSonar_reState = self.global_sonar_dyc.get_configuration(
                    timeout=None)
                getLocalSonar_reState = self.local_sonar_dyc.get_configuration(
                    timeout=None)
                if self.uvc_state == 1:
                    # sonar configure
                    if getGlobalSonar_reState['enabled'] != False and getLocalSonar_reState['enabled'] != False:
                        self.enable_ultrasonic = False
                        self.global_sonar_dyc.update_configuration(
                            {"enabled": self.enable_ultrasonic})
                        self.local_sonar_dyc.update_configuration(
                            {"enabled": self.enable_ultrasonic})
                    else:
                        pass

                    # vel
                    if getStatePlanner['max_vel_x'] > self.vel_user.uvc_speed:
                        self.set_max_vel_planner = self.vel_user.uvc_speed
                        self.planner_vel_dyc.update_configuration(
                            {"max_vel_x": self.set_max_vel_planner})
                    else:
                        pass
                else:

                    if getStatePlanner['max_vel_x'] > self.set_layout_vel:
                        self.set_max_vel_planner = min(
                            self.vel_user.move_speed, self.set_layout_vel)
                        self.planner_vel_dyc.update_configuration(
                            {"max_vel_x": self.set_max_vel_planner})
                    else:
                        pass

                    if getLocalSonar_reState['enabled'] != self.enable_ultrasonic and getGlobalSonar_reState['enabled'] != self.enable_ultrasonic:
                        self.global_sonar_dyc.update_configuration(
                            {"enabled": self.enable_ultrasonic})
                        self.local_sonar_dyc.update_configuration(
                            {"enabled": self.enable_ultrasonic})
                    else:
                        pass

                    # self.isTrigger = False
                    # print("complete set param")
                    # print(" ")

            else:

                # if not self.init_vel:
                #     rospy.loginfo("[matrix_dynamic_parameter]:Initial velocity for local planner")
                #     self.set_max_vel_planner = min(self.vel_user.move_speed, self.set_layout_vel)
                #     self.planner_vel_dyc.update_configuration({"max_vel_x":self.set_max_vel_planner})
                #     self.planner_vel_dyc.update_configuration({"max_speed_xy":self.set_max_vel_planner})
                #     self.init_vel = True
                #     rospy.loginfo(" ")

                try:
                    # self.no_zone_vel = self.vel_user.move_speed
                    if getStatePlanner['max_vel_x'] != self.vel_user.move_speed or getStatePlanner['max_vel_x'] != self.set_layout_vel or not self.init_vel:
                        # if getStatePlanner['max_vel_x'] != self.set_layout_vel or not self.init_vel :
                        self.set_max_vel_planner = min(
                            self.vel_user.move_speed, self.set_layout_vel)
                    else:
                        pass

                    # if getStatePlanner['max_vel_x'] != self.set_layout_vel or not self.init_vel:
                    #     self.set_max_vel_planner = min(self.vel_user.move_speed, self.set_layout_vel)

                    if self.set_max_vel_planner != getStatePlanner['max_vel_x'] or not self.init_vel:
                        if self.planner_name == "DWB":
                            self.planner_vel_dyc.update_configuration({"max_speed_xy": self.set_max_vel_planner,
                                                                       "max_vel_x": self.set_max_vel_planner})
                        elif self.planner_name == "DWA":
                            self.planner_vel_dyc.update_configuration({"max_vel_x": self.set_max_vel_planner,
                                                                       "max_vel_trans": self.set_max_vel_planner})
                        else:
                            try:
                                if self.hw_ver == "sdr100B":
                                    self.planner_vel_dyc.update_configuration({"max_vel_x": self.set_max_vel_planner,
                                                                               "max_vel_theta": self.set_max_vel_planner*2})
                                elif self.hw_ver == "smr100et":
                                    if self.set_max_vel_planner >= 0.4:
                                        self.planner_vel_dyc.update_configuration({"max_vel_x": self.set_max_vel_planner,
                                                                                   "max_vel_theta": self.set_max_vel_planner})
                                    else:
                                        self.planner_vel_dyc.update_configuration({"max_vel_x": self.set_max_vel_planner,
                                                                                   "max_vel_theta": 0.4})
                                else:
                                    self.planner_vel_dyc.update_configuration(
                                        {"max_vel_x": self.set_max_vel_planner})
                            except:
                                self.planner_vel_dyc.update_configuration(
                                    {"max_vel_x": self.set_max_vel_planner})
                        self.init_vel = True
                except:
                    print("something went wrong")
                # print("self.set_layout_vel", getStatePlanner['max_vel_x'])

        except:
            pass

        # print(getStatePlanner['max_vel_x'])

            # if getLocalSonar_reState['enabled'] != self.enable_ultrasonic and getGlobalSonar_reState['enabled'] != self.enable_ultrasonic:
            #     self.global_sonar_dyc.update_configuration({"enabled":self.enable_ultrasonic})
            #     self.local_sonar_dyc.update_configuration({"enabled":self.enable_ultrasonic})
            # else:
            #     pass

        # print("[dyanmics_nav_param]: Trigger zone:", self.current_zone)
        if self.current_zone != self.old_zone:
            # set dynamic costmap
            print("[dyanmics_nav_param]: Trigger zone:", self.current_zone)
            self.update_nav_layer()
            self.isTrigger = False
            print("complete set param")
            print(" ")
            self.old_zone = self.current_zone
        else:
            pass

    def update_nav_layer(self):

        # self.local_costmap_dynamics_client.update_configuration({"cost_scaling_factor":self.set_local_scaling_factor,
        #                                                    "inflation_radius":self.set_local_inflation_radius})
        # self.global_costmap_dynamics_client.update_configuration({"cost_scaling_factor":self.set_global_scaling_factor,
        #                                                    "inflation_radius":self.set_global_inflation_radius})

        # set param max velocity planner
        # self.planner_vel_dyc.update_configuration({"max_vel_x":self.self.set_max_vel_planner})

        # set param move_base
        # self.move_base_dyc.update_configuration({"planner_frequency":self.set_planner_frequency})

        # enable / disable ultrasonic costmap
        try:
            if (self.usr_global_layer["ultrasonic"]):
                self.global_sonar_dyc.update_configuration(
                    {"enabled": self.enable_ultrasonic})
                self.local_sonar_dyc.update_configuration(
                    {"enabled": self.enable_ultrasonic})
            else:
                self.global_sonar_dyc.update_configuration({"enabled": False})
                self.local_sonar_dyc.update_configuration({"enabled": False})
        except:
            rospy.logwarn(
                "[matrix_dynamics_navigation]:not found sonar_obstacle_layer")

        # enable / disable rgbd_layer
        try:
            if (self.usr_global_layer["3d_obstacle"]):
                self.global_rgbd_layer_dyc.update_configuration(
                    {"enabled": self.enable_global_rgbd})
                self.local_rgbd_layer_dyc.update_configuration(
                    {"enabled": self.enable_local_rgbd})
            else:
                self.global_rgbd_layer_dyc.update_configuration(
                    {"enabled": False})
                self.local_rgbd_layer_dyc.update_configuration(
                    {"enabled": False})
        except:
            rospy.logwarn(
                "[matrix_dynamics_navigation]:not found rgbd_obstacle_layer")

        # set Static Map following zone
        # self.static_map_layer_dyc.update_configuration({"enabled":self.enable_static_map})


if __name__ == '__main__':
    rospy.init_node('dynamic_params')
    DynamicsCostmap()
    rospy.spin()
