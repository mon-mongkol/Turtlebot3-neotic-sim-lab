            pass

        try:

            if self.robot_selno.find("ET") != -1:
                # pass
                # rgbd_layer
                self.local_rgbd_layer_dyc = dynamic_reconfigure.client.Client(
                    "/move_base/local_costmap/rgbd_obstacle_layer", config_callback=self.local_rgbd_callback)
                self.global_rgbd_layer_dyc = dynamic_reconfigure.client.Client(
                    "/move_base/global_costmap/rgbd_obstacle_layer", config_callback=self.global_rgbd_callback)
