        self.move_base = actionlib.SimpleActionClient(
            "move_base", MoveBaseAction)

        # Allow up to 5 seconds for the action server to come up
        print("wait for move_bse comeup")
        self.move_base.wait_for_server()
        print("movebase_ready")

        self.planner_name = ""
        try:
            if rospy.has_param('/move_base/DWBLocalPlanner/max_vel_x'):
                # DWB_plannner
                self.planner_vel_dyc = dynamic_reconfigure.client.Client(
                    "/move_base/DWBLocalPlanner", config_callback=self.teb_callback)
                self.planner_name = "DWB"
            # elif rospy.has_param('/move_base/DWAPlannerROS/max_vel_x'):
            #     self.planner_vel_dyc = dynamic_reconfigure.client.Client("/move_base/DWAPlannerROS", config_callback=self.teb_callback)
            #     self.planner_name = "DWA"
            else:
                # Teb_plannner
                self.planner_vel_dyc = dynamic_reconfigure.client.Client(
                    "/move_base/TebLocalPlannerROS", config_callback=self.teb_callback)
                self.planner_name = "TEB"
        except:
            pass

        rospy.loginfo('[matrix_dynamic_parameter]:' +
                      'LocalPlanner: ' + self.planner_name)
        rospy.loginfo('[matrix_dynamic_parameter]:' + " ")
        rospy.loginfo('[matrix_dynamic_parameter]:' +
                      "Move_base come up Ready !!!")

        #######################################################
        ################ Subscribe Topic ######################
        #######################################################
        # /robot_zone for dynamics costmap
        self.robot_zone = rospy.Subscriber("/robot_zone", Zones, self.cbZone)
        self.subUiMap = rospy.Subscriber(
            "/gui_layout_map", UIMap, self.cbUIMap)
        self.subRobotMode = rospy.Subscriber(
