class DynamicsCostmap:
    def __init__(self):

        self.min_vel_planning = 0.15
        self.max_vel_planning = 1.0

        self.current_zone = 0
        self.old_zone = 0

        self.set_global_inflation_radius = 0.54
        self.set_global_cost_scaling_factor = 10.00

        self.set_local_inflation_radius = 0.54
        self.set_local_cost_scaling_factor = 10.0

        self.set_layout_vel = 1.0
        self.set_oldlayout_vel = 0

        self.isTrigger = False
        self.old_set_cost_scaling_factor = 0.00

        self.enable_ultrasonic = False

        self.isEnable3DLayer = True
        self.isEnableMovementSound = True
        self.enable_local_rgbd = True
        self.enable_global_rgbd = True
        self.enable_static_map = True

        self.set_global_decay_voxel = 0.25
        self.set_global_mark_threshold = 0.25
        self.set_local_decay_voxel = 0.25
        self.set_local_mark_threshold = 3.5

        self.set_planner_frequency = 0.0

        self.UIMap_ = UIMap()

        self.init_vel = False

        self.set_max_vel_planner = 0.0

        self.orange_zone_vel = 0.0
        self.yellow_zone_vel = 0.0
        self.green_zone_vel = 0.0
        self.room_zone_vel = 0.0
        self.no_zone_vel = 0.0

        self.usr_local_layer = [False, False, False, False, False]
        self.usr_global_layer = [False, False, False, False, False]

        nav_layer = {
            "static_map": True,
            "ist_prohibition": True,
            "ultrasonic": False,
            "2d_obstacle": True,
            "3d_obstacle": True
        }

        self.usr_local_layer = dict(nav_layer)
        self.usr_global_layer = dict(nav_layer)

        self.local_seem_global_layer = False

        self.init_dynamics = False

        rospy.loginfo("[matrix_dynamic_parameter]:Get robot info ---------->>")
        # get robot model
        try:
            self.robot_model = os.environ['model']
        except:
            self.robot_model = "uvc"

        try:
            self.hw_ver = os.environ['hw_ver']
        except:
            self.hw_ver = "unknow"

        # get serial no. of robot
        try:
            self.robot_selno = os.environ['serial_no']
        except:
            self.robot_selno = os.environ['MATRIX_UVD_SERIAL_NO']

        rospy.loginfo('[matrix_dynamic_parameter]:' +
                      'model: ' + self.robot_model)
        rospy.loginfo('[matrix_dynamic_parameter]:' +
                      'serial_no: ' + self.robot_selno)

