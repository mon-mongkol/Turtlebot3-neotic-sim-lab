        ################ Dynamics Reconfigure parameter #####################
        #####################################################################
        # inflection_costmap_param
        try:

            self.local_costmap_dynamics_client = dynamic_reconfigure.client.Client(
                "/move_base/local_costmap/inflation_layer", config_callback=self.local_callback)
            self.global_costmap_dynamics_client = dynamic_reconfigure.client.Client(
                "/move_base/global_costmap/inflation_layer", config_callback=self.global_callback)

            # sonar_layer
            if self.robot_model == 'uvc':
                self.global_sonar_dyc = dynamic_reconfigure.client.Client(
                    "/move_base/global_costmap/sonar_layer", config_callback=self.global_sonar_callback)
                self.local_sonar_dyc = dynamic_reconfigure.client.Client(
                    "/move_base/local_costmap/sonar_layer", config_callback=self.local_sonar_callback)
                self.global_rgbd_layer_dyc = dynamic_reconfigure.client.Client(
                    "/move_base/global_costmap/rgbd_obstacle_layer", config_callback=self.global_rgbd_callback)
            else:
                pass

            self.static_map_layer_dyc = dynamic_reconfigure.client.Client(
                "/move_base/global_costmap/static_layer", config_callback=self.static_callback)

            # Move_base
            # self.move_base_dyc = dynamic_reconfigure.client.Client("/move_base", config_callback=self.move_base_callback)

