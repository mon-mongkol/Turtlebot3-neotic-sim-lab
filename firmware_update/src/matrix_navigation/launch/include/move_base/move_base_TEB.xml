<launch>
    <!--node ns="local_costmap" name="voxel_grid_throttle" pkg="topic_tools" type="throttle" args="messages voxel_grid 3.0 voxel_grid_throttled" /-->
    <arg name="local_planner" default="dwa" doc="Local planner can be either dwa, base, teb or pose"/>
    <arg name="with_virtual_walls" default="true" doc="Enables usage of virtual walls when set. Set to false when running SLAM." />
    <arg name="prefix" default="" doc="Prefix used for robot tf frames" /> <!-- used in the config files -->

    

    <arg name="sub_model" value="$(env sub_model)"/>
    <arg name="hw_ver" value="$(env hw_ver)"/>

    <group if="$(eval sub_model == 'sdr100')">
        <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen" clear_params="true">
            <!-- <param name="SBPLLatticePlanner/primitive_filename" value="$(find matrix_navigation)/mprim/unicycle_highcost_5cm.mprim" /> -->
            <rosparam file="$(find matrix_navigation)/config/move_base_common_params_$(env sub_model).yaml" command="load" />
            <!-- <rosparam file="$(find matrix_navigation)/config/sbpl_global_params.yaml" command="load" /> -->
            <rosparam file="$(find matrix_navigation)/config/globalplanner_global_params_$(env sub_model).yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/teb_local_planner_params_$(env sub_model)_$(env hw_ver).yaml" command="load" />

            <!-- global costmap params -->
            <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="global_costmap" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_global_params_$(env sub_model).yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/costmap_global_params_plugins_$(env sub_model).yaml" command="load"/>

            <!-- local costmap params -->
            <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="local_costmap" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_local_params_$(env sub_model).yaml" command="load" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_local_params_plugins_$(env sub_model).yaml" command="load"/>
        </node>
    </group>

    <group if="$(eval sub_model == 'smr100')">

        <group if="$(eval hw_ver == 'smr100R')">
            <include file="$(find matrix_rohm_navigation)/launch/move_base.xml"/>
        </group>

        <group unless="$(eval hw_ver == 'smr100R')">
            <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="log" clear_params="true">
                <!-- <param name="SBPLLatticePlanner/primitive_filename" value="$(find matrix_navigation)/mprim/unicycle_highcost_5cm.mprim" /> -->

                <rosparam file="$(find matrix_navigation)/config/move_base_common_params_$(env sub_model)_$(env hw_ver).yaml" command="load" />
                <!-- <rosparam file="$(find matrix_navigation)/config/sbpl_global_params.yaml" command="load" /> -->
                <rosparam file="$(find matrix_navigation)/config/globalplanner_global_params_ROHM.yaml" command="load" />
                <!-- <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/> -->
                <rosparam file="$(find matrix_navigation)/config/teb_local_planner_params_$(env sub_model)_$(env hw_ver).yaml" command="load" />
                <rosparam file="$(find matrix_navigation)/config/dwa_local_planner_params_$(env sub_model)_$(env hw_ver).yaml" command="load" />
                <!-- <rosparam file="$(find matrix_navigation)/config/dwa_local_planner_params_$(env sub_model)_$(env hw_ver).yaml" command="load" /> -->

                
                <!-- <group if="$(eval hw_ver == 'smr100R')">
                    <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model)_without3D.yaml" command="load" ns="global_costmap" subst_value="true" />
                    <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model)_without3D.yaml" command="load" ns="local_costmap" subst_value="true" />
                </group>

                <group unless="$(eval hw_ver == 'smr100R')"> -->
                    <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="global_costmap" subst_value="true" />
                    <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="local_costmap" subst_value="true" />
                <!-- </group> -->
                
                <!-- global costmap params -->
                <rosparam file="$(find matrix_navigation)/config/costmap_global_params_$(env sub_model).yaml" command="load" />
                <rosparam file="$(find matrix_navigation)/config/costmap_global_params_plugins_$(env sub_model).yaml" command="load"/>

                <!-- local costmap params -->
                <rosparam file="$(find matrix_navigation)/config/costmap_local_params_$(env sub_model).yaml" command="load" subst_value="true" />
                <rosparam file="$(find matrix_navigation)/config/costmap_local_params_plugins_$(env sub_model).yaml" command="load"/>
            </node>
        </group>
    </group>

    <group if="$(eval sub_model == 'smr100et')">
        <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen" clear_params="true">
            <!-- <param name="SBPLLatticePlanner/primitive_filename" value="$(find matrix_navigation)/mprim/unicycle_highcost_5cm.mprim" /> -->
            <rosparam file="$(find matrix_navigation)/config/move_base_common_params_$(env sub_model).yaml" command="load" />
            <!-- <rosparam file="$(find matrix_navigation)/config/sbpl_global_params.yaml" command="load" /> -->
            <rosparam file="$(find matrix_navigation)/config/globalplanner_global_params_$(env sub_model).yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/teb_local_planner_params_$(env sub_model)_$(env hw_ver).yaml" command="load" />

            <!-- global costmap params -->
            <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="global_costmap" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_global_params_$(env sub_model).yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/costmap_global_params_plugins_$(env sub_model).yaml" command="load"/>

            <!-- local costmap params -->
            <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="local_costmap" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_local_params_$(env sub_model).yaml" command="load" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_local_params_plugins_$(env sub_model).yaml" command="load"/>
        </node>
    </group>

    <group if="$(eval sub_model == 'smr100eb')">
        <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen" clear_params="true">
            <!-- <param name="SBPLLatticePlanner/primitive_filename" value="$(find matrix_navigation)/mprim/unicycle_highcost_5cm.mprim" /> -->
            <rosparam file="$(find matrix_navigation)/config/move_base_common_params_$(env sub_model).yaml" command="load" />
            <!-- <rosparam file="$(find matrix_navigation)/config/sbpl_global_params.yaml" command="load" /> -->
            <rosparam file="$(find matrix_navigation)/config/globalplanner_global_params_$(env sub_model).yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/teb_local_planner_params_$(env sub_model)_$(env hw_ver).yaml" command="load" />

            <!-- global costmap params -->
            <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="global_costmap" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_global_params_$(env sub_model).yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/costmap_global_params_plugins_$(env sub_model).yaml" command="load"/>

            <!-- local costmap params -->
            <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="local_costmap" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_local_params_$(env sub_model).yaml" command="load" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_local_params_plugins_$(env sub_model).yaml" command="load"/>
        </node>
    </group>

    <group if="$(eval sub_model == 'smr200')">
        <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen" clear_params="true">
            <param name="SBPLLatticePlanner/primitive_filename" value="$(find matrix_navigation)/mprim/unicycle_highcost_5cm.mprim" />
            <rosparam file="$(find matrix_navigation)/config/move_base_common_params_$(env sub_model).yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/sbpl_global_params.yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/globalplanner_global_params.yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/teb_local_planner_params_$(env sub_model)_$(env hw_ver).yaml" command="load" />

            <!-- global costmap params -->
            <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="global_costmap" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_global_params_$(env sub_model).yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/costmap_global_params_plugins_$(env sub_model).yaml" command="load"/>

            <!-- local costmap params -->
            <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="local_costmap" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_local_params_$(env sub_model).yaml" command="load" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_local_params_plugins_$(env sub_model).yaml" command="load"/>
        </node>
    </group>

    <group if="$(eval sub_model == 'smr1000')">
        <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen" clear_params="true">
            <param name="SBPLLatticePlanner/primitive_filename" value="$(find matrix_navigation)/mprim/unicycle_highcost_5cm.mprim" />
            <rosparam file="$(find matrix_navigation)/config/move_base_common_params_$(env sub_model).yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/sbpl_global_params.yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/globalplanner_global_params.yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/teb_local_planner_params_$(env sub_model)_$(env hw_ver).yaml" command="load" />

            <!-- global costmap params -->
            <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="global_costmap" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_global_params_$(env sub_model).yaml" command="load" />
            <rosparam file="$(find matrix_navigation)/config/costmap_global_params_plugins_$(env sub_model).yaml" command="load"/>

            <!-- local costmap params -->
            <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model).yaml" command="load" ns="local_costmap" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_local_params_$(env sub_model).yaml" command="load" subst_value="true" />
            <rosparam file="$(find matrix_navigation)/config/costmap_local_params_plugins_$(env sub_model).yaml" command="load"/>
        </node>
    </group>



    
    
</launch>
