<launch>
    <!--node ns="local_costmap" name="voxel_grid_throttle" pkg="topic_tools" type="throttle" args="messages voxel_grid 3.0 voxel_grid_throttled" /-->
    <arg name="local_planner" default="dwa" doc="Local planner can be either dwa, base, teb or pose"/>
    <arg name="with_virtual_walls" default="true" doc="Enables usage of virtual walls when set. Set to false when running SLAM." />
    <arg name="prefix" default="" doc="Prefix used for robot tf frames" /> <!-- used in the config files -->

    

    <arg name="sub_model" value="$(env sub_model)"/>

    <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen" clear_params="true">
        <param name="SBPLLatticePlanner/primitive_filename" value="$(find matrix_navigation)/mprim/unicycle_highcost_5cm.mprim" />
        <rosparam file="$(find matrix_navigation)/config/move_base_common_params_$(env sub_model)_AR.yaml" command="load" />
        <rosparam file="$(find matrix_navigation)/config/sbpl_global_params.yaml" command="load" />
        <!-- <rosparam file="$(find matrix_navigation)/config/globalplanner_global_params.yaml" command="load" /> -->
        <rosparam file="$(find matrix_navigation)/config/teb_local_planner_params_$(env sub_model)_$(env hw_ver)_AR.yaml" command="load" />

        <!-- global costmap params -->
        <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model)_AR.yaml" command="load" ns="global_costmap" subst_value="true" />
        <rosparam file="$(find matrix_navigation)/config/costmap_global_params_$(env sub_model)_AR.yaml" command="load" />
        <rosparam file="$(find matrix_navigation)/config/costmap_global_params_plugins_$(env sub_model)_AR.yaml" command="load"/>

        <!-- local costmap params -->
        <rosparam file="$(find matrix_navigation)/config/costmap_common_params_$(env sub_model)_AR.yaml" command="load" ns="local_costmap" subst_value="true" />
        <rosparam file="$(find matrix_navigation)/config/costmap_local_params_$(env sub_model)_AR.yaml" command="load" subst_value="true" />
        <rosparam file="$(find matrix_navigation)/config/costmap_local_params_plugins_$(env sub_model)_AR.yaml" command="load"/>
    </node>


    
    
</launch>
