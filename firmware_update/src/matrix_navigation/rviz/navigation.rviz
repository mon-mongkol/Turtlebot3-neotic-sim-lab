Panels:
  - Class: rviz/Displays
    Help Height: 81
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Grid1/Offset1
        - /TF1/Frames1
        - /TF1/Tree1
        - /Global Map1/Footprint1
        - /Local Map1/Local Plan (MiR)1
        - /Local Map1/DWB Markers1/Namespaces1
        - /PointCloud21
      Splitter Ratio: 0.3309222459793091
    Tree Height: 359
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: PointCloud2
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
