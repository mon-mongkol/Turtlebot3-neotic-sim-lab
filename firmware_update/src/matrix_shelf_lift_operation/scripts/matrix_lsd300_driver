            rospy.set_param("~dual_motor_id", 1)
        if not rospy.has_param("~motor_1_id"):
            rospy.set_param("~motor_1_id", 3)
        if not rospy.has_param("~motor_2_id"):
            rospy.set_param("~motor_2_id", 2)
        if not rospy.has_param("~accel_time"):
            rospy.set_param("~accel_time", 100)
        if not rospy.has_param("~decel_time"):
            rospy.set_param("~decel_time", 100)
        if not rospy.has_param("~velocity_unit_rpm"):
            rospy.set_param("~velocity_unit_rpm", 1)
        self.device_name = rospy.get_param("~device_name")
        self.dual_driver_motor = rospy.get_param("~dual_driver_motor")
        self.use_matrix_navgo_bypass = rospy.get_param("~use_matrix_navgo_bypass")
        self.can_device = rospy.get_param("~can_device")
        self.can_bitrate = rospy.get_param("~canbus_bitrate")
        self.dual_motor_id = rospy.get_param("~dual_motor_id")
        self.motor_1_id = rospy.get_param("~motor_1_id")
        self.motor_2_id = rospy.get_param("~motor_2_id")
        self.accel_time = rospy.get_param("~accel_time")
        self.decel_time = rospy.get_param("~decel_time")
        self.velocity_unit_rpm = rospy.get_param("~velocity_unit_rpm")


        self.ControlState = Enum('ControlState', ['INIT', 'MANUAL_MODE', 'ROBOT_SYSTEM_CHECK', 'MOTOR_STATE_CHECK', 'INIT_MOTOR', 'WAIT_STATUSWORD_ENABLED', 'BASE_CONTROL', 'GET_ACTUAL_VELOCITY', 'FINAL', 'FAULT_CHECKING', 'FAULT_DETECTED', 'CLEAR_FAULT', 'ERROR', 'PAUSE'])
        self.control_state = Enum('control_state', ['INIT', 'CHECK_MANUAL', 'CHECK_AUTO', 'MOVE_AUTO', 'MANUAL_INTERUPT', 'EMERGENCY', 'ERR', 'PAUSE', 'FINISH'])
        self.motion = Enum('motion', ['IDEL', 'STOP', 'UP', 'DOWN', 'RST'])
        self.error_state = Enum('error_state', ['NOT_FOUND_OBJ', 'LIFT_TOO_HIGH', 'LIFT_TOO_LOW', 'CLOSE_OBJ'])
        self.motion_seqs = Enum('motion_seqs', ['check_obj', 'check_env', 'go_stop', 'go_ctrl', 'go_finish'])
        self.motion_results = Enum('motion_results', ['pending', 'manualInterupt', 'limitH_NotcloseOBJ', 'limitH_closeOBJ', 'limitL', 'limitL_NotcloseOBJ', 'limitL_closeOBJ', 'ctrlStateErr', 'notFoundOBJ', 'mstop'])



        self.isSim = False


        self.motor_1_id = 3
 

        self.current_time = rospy.Time.now()
        self.last_time = rospy.Time.now()
        self.message = Frame()

        self.LED_CONTROL_RATE = 1
        self.HB_RATE = 3
        self.IOSTATE_RATE = 10

        self.obj_detector = 0
        self.closer_detector = 0
        self.liml_detector = 0
        self.limh_detector =0
        self.EMO = 0
        self.up_button= 0
        self.down_button = 0

        self.motion_req_goal = self.motion.IDEL.value
        self.motion_req_complete = False
        self.motion_result = 0
