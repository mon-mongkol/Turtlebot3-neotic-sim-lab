        self.motion_ctrl_complete = False

        self.send_result = False

        self.control_seq = 0

        self.isAutoMode = False
        self.isButtonInterupt = True
        self.isSkipCheckOBJ = False
        self.isInitial_Trigger = False
        self.isInitial_Finish = False
        self.isInitial_Success = False
        self.isReset = False


        self.up_stmp_time = 0
        self.down_stmp_time = 0
        self.init_up_stmp = False
        self.init_down_stmp = False

        self.statusword_stmp = 0

        self.up_press_time = 0
        self.down_press_time = 0

        self.prev_led_control_time = 0
