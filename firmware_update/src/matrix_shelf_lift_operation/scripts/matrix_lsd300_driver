        self.control_seq = self.control_state.INIT.value
        self.motion_req_complete = True

        self.fst_data_come = False
        self.current_motor_state =""
        self.motor_status = DeviceStateCanopen()
        self.ControlState_seq = self.ControlState.INIT.value

        try:
            self.bus = can.Bus(interface='socketcan',
                                channel=self.can_device,
                                receive_own_messages=False,
                                bitrate=self.can_bitrate)

            self.buffer = can.BufferedReader()
            self.notifier = can.Notifier(self.bus, [self._get_message, self.buffer])

        except:
            print("[matrix_CanOpenLifter_LSD100]: cansocket name {} not found.please check list network interfaces".format(self.can_device))
