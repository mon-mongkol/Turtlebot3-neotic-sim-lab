<?xml version="1.0"?>
<launch>
    <arg name="scan_topic" default="/scan"/>
    <arg name="rosbag" />

    <arg name="particles" default="30"/>
    <arg name="d_thresh"  default="0.01"/>
    <arg name="a_thresh"  default="0.25"/>
    <arg name="mrange"    default="30"/>

    <arg name="threads"   default="4"/>
    <arg name="use_compression" default="false"/>

    <!--<param name="/use_sim_time" value="false"/>-->

    <node pkg="iris_lama_ros" name="slam2d_ros" type="slam2d_ros" output="screen" >
        <param name="scan_topic" value="$(arg scan_topic)"/>
        <param name="base_frame_id" value="base_footprint"/>
        <!--<param name="rosbag"     value="$(arg rosbag)"/>-->

        <param name="d_thresh"  value="$(arg d_thresh)"/>
        <param name="a_thresh"  value="$(arg a_thresh)"/>
        <param name="mrange"    value="$(arg mrange)"/>

        <param name="use_compression" value="$(arg use_compression)"/>

        <param name="create_summary"     value="true"/>
        <param name="map_publish_period" value="1.0" />
    </node>
    <!--<include file="$(find aragorn_navigation_demo)/launch/move_base.launch"/>-->

    <!-- <node name="map2odom" pkg="tf" type="static_transform_publisher" args="0 0 0 0 0 0 1 /map /odom 100"/> -->
</launch>
