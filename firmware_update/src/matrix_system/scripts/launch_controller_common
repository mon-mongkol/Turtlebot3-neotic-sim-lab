    def cbCancelAction(self, req):
        if req.data:
            try:
                media_playerSRV = rospy.ServiceProxy('media_player_server', MediaPlayer)
                srv_req = MediaPlayerRequest()

                srv_req.cmd = "clear"

                srv_res = media_playerSRV(srv_req) 
            except:
                pass
            # os.system('echo \"a\" | sudo -S service ONodeREDUser stop')
            self.move_base.cancel_all_goals()
            self.serial_operation.cancel_all_goals()
            self.movement_operation.cancel_all_goals()
            self.artrack_operation.cancel_all_goals()
            self.swapenvi_operation.cancel_all_goals()
            self.docking_operation.cancel_all_goals()
            self.schedule_operation.cancel_all_goals()
            self.ar3mark_operation.cancel_all_goals()
            self.ardocking_operation.cancel_all_goals()

            self.IST_Docking.cancel_all_goals()
            self.IST_RouteFollow.cancel_all_goals()
            # os.system('echo \"a\" | sudo -S service ONodeREDUser start')
            # os.system('echo \"a\" | sudo -S service ONodeREDUser restart')
        
        return True, "Success"
    
    def cbActionControllerServer(self, req):
        rospy.loginfo("[Launch control]: Request cmd %s, action_name %s ", req.cmd, req.action_name)
        success = False
        if req.cmd == ActionControllerRequest.CMD_ACTION_START or req.cmd == ActionControllerRequest.CMD_ACTION_KILL:
            # get lauch state
            action_launch_state = False
            if req.cmd == ActionControllerRequest.CMD_ACTION_START:
                action_launch_state = True
            else:
                pass
            
            # get Action launch file
            action_name = self.Launcher.launch_init.value
            if req.action_name == ActionControllerRequest.AC_AR3_REAR:
                action_name = self.Launcher.launch_ar3mark_operation_rear.value
            elif req.action_name == ActionControllerRequest.AC_AR3_FRONT:
                action_name = self.Launcher.launch_ar3mark_operation_front.value
            else:
                rospy.logerr("[Launch control]: Not found action name %s, please in matix_msgs/ActionController.srv ", req.action_name)
            
            # launch control
            if action_name != self.Launcher.launch_init.value:
                try:
                    self.fnLaunch(action_name, False, action_launch_state)
                    success = True
                except:
                    rospy.logerr("[Launch control]: call launch error %s", req.action_name)
                    success = False
            else:
                success = False
                
        elif req.cmd == ActionControllerRequest.CMD_ACTION_CANCEL:
            if req.action_name == ActionControllerRequest.AC_MOVEMENT:
                try:
                    self.move_base.cancel_all_goals()
                    self.movement_operation.cancel_all_goals()
                    self.docking_operation.cancel_all_goals()
                    self.ar3mark_operation.cancel_all_goals()
                    self.ardocking_operation.cancel_all_goals()
                    self.IST_Docking.cancel_all_goals()
                    self.IST_RouteFollow.cancel_all_goals()
                except:
                    rospy.logerr("[Launch control]: error while cancelling action %s", req.action_name)
            else:
                rospy.logerr("[Launch control]: Not found action name %s, please in matix_msgs/ActionController.srv ", req.action_name)
                success = False
        
        else:
            rospy.logerr("[Launch control]: Not found cmd %s, please in matix_msgs/ActionController.srv ", req.cmd)
            success = False
        
        return success

    
