                    if self.launch_docking_ar_operation_launched == False:
                        self.launch_docking_ar_operation = roslaunch.scriptapi.ROSLaunch()
                        self.launch_docking_ar_operation = roslaunch.parent.ROSLaunchParent(self.uuid, [self.rospack.get_path(self.model_launch_pkg) + "/launch/docking_ar_operation.launch"])
                        self.launch_docking_ar_operation_launched = True
                        self.launch_docking_ar_operation.start()
                    else:
                        pass
                else:
                    if self.launch_docking_ar_operation_launched == True:
                        self.launch_docking_ar_operation_launched = False
                        self.launch_docking_ar_operation.shutdown()
                    else:
                        pass
            else:
                pass


    def main(self):
        rospy.spin()
    
if __name__=='__main__':
    rospy.init_node('core_node_controller')
    node = CoreNodeController()
    node.main()