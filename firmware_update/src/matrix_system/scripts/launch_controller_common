    def cbModeLaunch(self, mode_msg):
        # rospy.loginfo("Start core_controller with mode %d", mode_msg)
        if(self.current_mode == mode_msg.robot_mode):
            pass
        else:
            self.current_mode = mode_msg.robot_mode
            self.is_triggered = True
    
    def initial_robot(self):
        # pass
        self.fnLaunch(self.Launcher.launch_tf.value, self.skip_tf, True)
        self.fnLaunch(self.Launcher.launch_core.value, self.skip_core, True)
        self.fnLaunch(self.Launcher.launch_lidar_f.value, self.skip_lidar_f, True)
        self.fnLaunch(self.Launcher.launch_lidar_r.value, self.skip_lidar_r, True)
        self.fnLaunch(self.Launcher.launch_lidar_merger.value, self.skip_lidar_merger, True)
        self.fnLaunch(self.Launcher.launch_sound.value, self.skip_sound, True)
        self.fnLaunch(self.Launcher.launch_mcu1.value, self.skip_mcu1, True)
        # self.fnLaunch(self.Launcher.launch_mcu2.value, self.skip_mcu2, True)
        self.fnLaunch(self.Launcher.launch_camera.value, self.skip_camera, True)
        self.fnLaunch(self.Launcher.launch_bms.value, self.skip_bms, True)
        self.fnLaunch(self.Launcher.launch_imu.value, self.skip_imu, True)
        # self.fnLaunch(self.Launcher.launch_laser_odom.value, self.skip_laser_odom, True)
        self.fnLaunch(self.Launcher.launch_localization.value, self.skip_localization, True)
        self.fnLaunch(self.Launcher.launch_movement_state.value, self.skip_movement_state, True)
        self.fnLaunch(self.Launcher.launch_dynamics_param.value, self.skip_dynamic_param, True)
        # self.fnLaunch(self.Launcher.launch_diagnostics.value, self.skip_diagnostics, True)
        self.fnLaunch(self.Launcher.launch_aragorn_bridge.value, self.skip_aragorn_bridge, True)
        self.fnLaunch(self.Launcher.launch_mode_controller.value, self.skip_mode_controller, True)
        self.fnLaunch(self.Launcher.launch_communication.value, self.skip_communication, True)
        self.fnLaunch(self.Launcher.launch_serial_operation.value, self.skip_serial_operation, True)
        self.fnLaunch(self.Launcher.launch_swapmap_operation.value, self.skip_swapmap_operation, True)
        self.fnLaunch(self.Launcher.launch_docking_operation.value, self.skip_docking_operation, True)

        # on when use
        self.fnLaunch(self.Launcher.launch_ar3mark_operation_rear.value, self.skip_ar3mark_operation_rear, False)
        self.fnLaunch(self.Launcher.launch_ar3mark_operation_front.value, self.skip_ar3mark_operation_front, False)

        self.fnLaunch(self.Launcher.launch_bumper.value, self.skip_bumper, True)
        self.fnLaunch(self.Launcher.launch_docking_ar_operation.value, self.skip_docking_ar_operation, True)

        self.fnLaunch(self.Launcher.launch_diagnostics.value, self.skip_diagnostics, True)

        try:
            os.system('echo \"a\" | sudo -S service ONodeREDUser start')
        except:
            pass

    
