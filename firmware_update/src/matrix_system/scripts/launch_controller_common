            self.fnLaunch(self.Launcher.launch_lidar_f.value, self.skip_lidar_f, False)
            self.fnLaunch(self.Launcher.launch_lidar_r.value, self.skip_lidar_r, False)
            self.fnLaunch(self.Launcher.launch_sound.value, self.skip_sound, False)
            self.fnLaunch(self.Launcher.launch_mcu1.value, self.skip_mcu1, False)
            self.fnLaunch(self.Launcher.launch_mcu2.value, self.skip_mcu2, False)
            self.fnLaunch(self.Launcher.launch_camera.value, self.skip_camera, False)
            self.fnLaunch(self.Launcher.launch_bms.value, self.skip_bms, False)
            self.fnLaunch(self.Launcher.launch_imu.value, self.skip_imu, False)
            self.fnLaunch(self.Launcher.launch_localization.value, self.skip_localization, False)
            # self.fnLaunch(self.Launcher.launch_autodock.value, False)
            # self.fnLaunch(self.Launcher.launch_manual_docking.value, False)
            self.fnLaunch(self.Launcher.launch_movement_state.value, self.skip_movement_state, False)
            # self.fnLaunch(self.Launcher.launch_dynamics_param.value, False)
            self.fnLaunch(self.Launcher.launch_diagnostics.value, self.skip_diagnostics, False)
            # self.fnLaunch(self.Launcher.launch_vel_filter.value, False)
            self.fnLaunch(self.Launcher.launch_core.value, self.skip_core, False)
            os.system("rosnode kill --all")
            os.system('echo \"a\" | sudo -S shutdown now')
        
        self.is_triggered = False

