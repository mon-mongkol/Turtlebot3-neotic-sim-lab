            if (skip == False):
                if is_start == True:
                    if self.launch_offline_control_operation_launched == False:
                        self.launch_offline_control_operation = roslaunch.scriptapi.ROSLaunch()
                        self.launch_offline_control_operation = roslaunch.parent.ROSLaunchParent(
                            self.uuid, [self.rospack.get_path(self.model_launch_pkg) + "/launch/offline_control_operation.launch"])
                        self.launch_offline_control_operation_launched = True
                        self.launch_offline_control_operation.start()
                    else:
                        pass
                else:
                    if self.launch_offline_control_operation_launched == True:
                        self.launch_offline_control_operation_launched = False
                        self.launch_offline_control_operation.shutdown()
                    else:
                        pass
            else:
                pass
        # launch_cvshape_operation
        elif launch_num == self.Launcher.launch_cvshape_operation.value:
            if (skip == False):
                if is_start == True:
                    if self.launch_cvshape_operation_launched == False:
                        self.launch_cvshape_operation = roslaunch.scriptapi.ROSLaunch()
                        self.launch_cvshape_operation = roslaunch.parent.ROSLaunchParent(
                            self.uuid, [self.rospack.get_path(self.model_launch_pkg) + "/launch/cvshape_operation.launch"])
                        self.launch_cvshape_operation_launched = True
                        self.launch_cvshape_operation.start()
                    else:
                        pass
                else:
                    if self.launch_cvshape_operation_launched == True:
                        self.launch_cvshape_operation_launched = False
                        self.launch_cvshape_operation.shutdown()
                    else:
                        pass
            else:
                pass

        # launch_io_operation
        elif launch_num == self.Launcher.launch_io_operation.value:
            if (skip == False):
                if is_start == True:
                    if self.launch_io_operation_launched == False:
                        self.launch_io_operation = roslaunch.scriptapi.ROSLaunch()
                        self.launch_io_operation = roslaunch.parent.ROSLaunchParent(
                            self.uuid, [self.rospack.get_path(self.model_launch_pkg) + "/launch/launch_io_operation"])
                        self.launch_io_operation_launched = True
                        self.launch_io_operation.start()
                    else:
                        pass
                else:
                    if self.launch_io_operation_launched == True:
                        self.launch_io_operation_launched = False
                        self.launch_io_operation.shutdown()
                    else:
                        pass
            else:
                pass

        # launch_sim
        elif launch_num == self.Launcher.launch_sim.value:
            if (skip == False):
                if is_start == True:
                    if self.launch_sim_launched == False:
                        self.launch_sim = roslaunch.scriptapi.ROSLaunch()
                        self.launch_sim = roslaunch.parent.ROSLaunchParent(
                            self.uuid, [self.rospack.get_path(self.model_launch_pkg) + "/launch/sim.launch"])
                        self.launch_sim_launched = True
                        self.launch_sim.start()
                    else:
                        pass
                else:
                    if self.launch_sim_launched == True:
                        self.launch_sim_launched = False
                        self.launch_sim.shutdown()
                    else:
                        pass
            else:
                pass

    def main(self):
        rospy.spin()


if __name__ == '__main__':
    rospy.init_node('core_node_controller', anonymous=True)
    node = CoreNodeController()
    node.main()
