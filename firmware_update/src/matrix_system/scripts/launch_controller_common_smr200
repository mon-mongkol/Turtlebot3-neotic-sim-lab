    def cbCancelAction(self, req):
        if req.data:
            try:
                os.system('killall -9 vlc')
            except:
                pass

            try:
                media_playerSRV = rospy.ServiceProxy(
                    'media_player_server', MediaPlayer)
                srv_req = MediaPlayerRequest()

                srv_req.cmd = "clear"

                srv_res = media_playerSRV(srv_req)
            except:
                pass

            # os.system('echo \"a\" | sudo -S service ONodeREDUser stop')

            self.move_base.cancel_all_goals()
            self.serial_operation.cancel_all_goals()
            self.serial_operation_485.cancel_all_goals()
            self.movement_operation.cancel_all_goals()
            self.artrack_operation.cancel_all_goals()
            self.swapenvi_operation.cancel_all_goals()
            self.docking_operation.cancel_all_goals()
            self.schedule_operation.cancel_all_goals()
            self.ar3mark_operation.cancel_all_goals()
            self.handlemat_operation.cancel_all_goals()
            self.ardocking_operation.cancel_all_goals()
            self.offcontrol_operation.cancel_all_goals()
            self.wallfollowing_operation.cancel_all_goals()
            self.cvshape_operation.cancel_all_goals()
            self.cvshape2dir_operation.cancel_all_goals()
            self.dockingmulti_operation.cancel_all_goals()
            self.shelf_lift_operation.cancel_all_goals()

            self.IST_Docking.cancel_all_goals()
            self.IST_RouteFollow.cancel_all_goals()

            # os.system('echo \"a\" | sudo -S service ONodeREDUser start')
            # os.system('echo \"a\" | sudo -S service ONodeREDUser restart')
            self.MatrixFlowController(self.matrixflow_state[4])

            rospy.logwarn("cancel node success")

        return True, "Success"

    def cbDynamics(self, config, level):

        if not config.restore_default:
            if config.manual_matrixflow_setup != 0:
                self.MatrixFlowController(config.manual_matrixflow_setup)
                config.matrixflow_ready = self.matrixflow_state_prev[0]
                config.matrixflow_start_motor = 0
                config.matrixflow_emergency = 0
                config.matrixflow_cancel_movement = 0
                config.matrixflow_cancel_all = 0
                self._isInitialDynamics = False
            else:
                if not self._isInitialDynamics:
                    config.matrixflow_ready = self.matrixflow_state_prev[0]
                    config.matrixflow_start_motor = self.matrixflow_state_prev[1]
                    config.matrixflow_emergency = self.matrixflow_state_prev[2]
                    config.matrixflow_cancel_movement = self.matrixflow_state_prev[3]
                    config.matrixflow_cancel_all = self.matrixflow_state_prev[4]
                    self._isInitialDynamics = True
                else:
                    pass
        else:
            config.manual_matrixflow_setup = 0
            config.matrixflow_ready = self.matrixflow_state_de[0]
            config.matrixflow_start_motor = self.matrixflow_state_de[1]
            config.matrixflow_emergency = self.matrixflow_state_de[2]
            config.matrixflow_cancel_movement = self.matrixflow_state_de[3]
            config.matrixflow_cancel_all = self.matrixflow_state_de[4]
            config.restore_default = False

        self.matrixflow_state[0] = config.matrixflow_ready
        self.matrixflow_state[1] = config.matrixflow_start_motor
        self.matrixflow_state[2] = config.matrixflow_emergency
        self.matrixflow_state[3] = config.matrixflow_cancel_movement
        self.matrixflow_state[4] = config.matrixflow_cancel_all

        return config

    def MatrixFlowController(self, mode):
        success = True
        if mode == 0:  # NONE
            pass
        elif mode == 1:  # START
            os.system('echo \"a\" | sudo -S systemctl start ONodeREDUser.service')
        elif mode == 2:  # STOP
            os.system('echo \"a\" | sudo -S systemctl stop ONodeREDUser.service')
        elif mode == 3:  # RESTART
            os.system(
                'echo \"a\" | sudo -S systemctl restart ONodeREDUser.service')
        else:
            rospy.logwarn(
                "[Matrix Launch control]: Not found mode: {}".format(mode))

        return success

    def cbActionControllerServer(self, req):
        rospy.loginfo(
            "[Matrix Launch control]: Request cmd %s, action_name %s ", req.cmd, req.action_name)
        self.fnControlNode_srv = req
        self.is_service_triggerd = True
        success = True
        return success, ""

    # fix bug only use "Signal in main thread"
    def fnControlNodeService(self):
        if self.is_service_triggerd:
            if self.fnControlNode_srv.cmd == ActionControllerRequest.CMD_ACTION_START or self.fnControlNode_srv.cmd == ActionControllerRequest.CMD_ACTION_KILL:
                # get lauch state
                action_launch_state = False
                if self.fnControlNode_srv.cmd == ActionControllerRequest.CMD_ACTION_START:
                    action_launch_state = True
                else:
                    pass

                # get Action launch file
                action_name = self.Launcher.launch_init.value
                if self.fnControlNode_srv.action_name == ActionControllerRequest.AC_AR3_REAR:
                    action_name = self.Launcher.launch_ar3mark_operation_rear.value
                elif self.fnControlNode_srv.action_name == ActionControllerRequest.AC_AR3_FRONT:
                    action_name = self.Launcher.launch_ar3mark_operation_front.value
                else:
                    rospy.logerr(
                        "[Matrix Launch control]: Not found action name %s, please in matix_msgs/ActionController.srv ", self.fnControlNode_srv.action_name)

                # launch control
                if action_name != self.Launcher.launch_init.value:
                    try:
                        self.fnLaunch(action_name, False, False)
                        rospy.loginfo("kill launch success")
                        self.fnLaunch(action_name, False, action_launch_state)
                        success = True
                    except ValueError:
                        rospy.logerr(
                            "[Matrix Launch control]: call launch error %s", self.fnControlNode_srv.action_name)
                        success = False
                    self.fnLaunch(action_name, False, action_launch_state)
                else:
                    success = False

            elif self.fnControlNode_srv.cmd == ActionControllerRequest.CMD_ACTION_CANCEL:
                if self.fnControlNode_srv.action_name == ActionControllerRequest.AC_MOVEMENT:
                    try:
                        self.MatrixFlowController(self.matrixflow_state[3])
                        self.move_base.cancel_all_goals()
                        self.movement_operation.cancel_all_goals()
                        self.docking_operation.cancel_all_goals()
                        self.ar3mark_operation.cancel_all_goals()
                        self.ardocking_operation.cancel_all_goals()
                        self.IST_Docking.cancel_all_goals()
                        self.IST_RouteFollow.cancel_all_goals()
                        self.offcontrol_operation.cancel_all_goals()
                        self.wallfollowing_operation.cancel_all_goals()
                        self.cvshape_operation.cancel_all_goals()
                        self.cvshape2dir_operation.cancel_all_goals()
                        self.dockingmulti_operation.cancel_all_goals()
                        self.shelf_lift_operation.cancel_all_goals()

                        self.IST_Docking.cancel_all_goals()
                        self.IST_RouteFollow.cancel_all_goals()
                    except:
                        rospy.logerr(
                            "[Matrix Launch control]: error while cancelling action %s", self.fnControlNode_srv.action_name)

                elif self.fnControlNode_srv.action_name == "STOP_ALL":
                    try:
                        os.system('killall -9 vlc')
                    except:
                        pass

                    try:
                        media_playerSRV = rospy.ServiceProxy(
                            'media_player_server', MediaPlayer)
                        srv_req = MediaPlayerRequest()

                        srv_req.cmd = "clear"

                        srv_res = media_playerSRV(srv_req)
                    except:
                        pass

                    # os.system('echo \"a\" | sudo -S service ONodeREDUser stop')

                    self.move_base.cancel_all_goals()
                    self.serial_operation.cancel_all_goals()
                    self.serial_operation_485.cancel_all_goals()
                    self.movement_operation.cancel_all_goals()
                    self.artrack_operation.cancel_all_goals()
                    self.swapenvi_operation.cancel_all_goals()
                    self.docking_operation.cancel_all_goals()
                    self.schedule_operation.cancel_all_goals()
                    self.ar3mark_operation.cancel_all_goals()
                    self.handlemat_operation.cancel_all_goals()
                    self.ardocking_operation.cancel_all_goals()
                    self.offcontrol_operation.cancel_all_goals()
                    self.wallfollowing_operation.cancel_all_goals()
                    self.cvshape_operation.cancel_all_goals()
                    self.cvshape2dir_operation.cancel_all_goals()
                    self.dockingmulti_operation.cancel_all_goals()
                    self.shelf_lift_operation.cancel_all_goals()

                    self.IST_Docking.cancel_all_goals()
                    self.IST_RouteFollow.cancel_all_goals()

                    # os.system('echo \"a\" | sudo -S service ONodeREDUser start')
                    self.MatrixFlowController(self.matrixflow_state[4])
                    success = True

                else:
                    rospy.logerr(
                        "[Matrix Launch control]: Not found action name %s, please in matix_msgs/ActionController.srv ", self.fnControlNode_srv.action_name)
                    success = False

            #  elif self.fnControlNode_srv.cmd == "MatrixFlowDesigner_setup":
            #     if self.fnControlNode_srv.arg0 == "start":
            #         os.system('echo \"a\" | sudo -S service ONodeREDUser start')
            #     elif self.fnControlNode_srv.arg0 == "stop":
            #         os.system('echo \"a\" | sudo -S service ONodeREDUser stop')
            #     elif self.fnControlNode_srv.arg0 == "restart":
            #         os.system('echo \"a\" | sudo -S service ONodeREDUser restart')
            #     else:
            #         pass
            else:
                rospy.logerr(
                    "[Matrix Launch control]: Not found cmd %s, please in matix_msgs/ActionController.srv ", self.fnControlNode_srv.cmd)
                success = False

            self.is_service_triggerd = False
        else:
            pass

