    def fnControlNode(self):
        # Start_robot mode
        if self.current_mode == RobotMode.START_MOTOR:
            rospy.loginfo(
                "[Matrix Launch control]: Now trigger for Start motor drive")
            self.MatrixFlowController(self.matrixflow_state[1])
            # os.system('echo \"a\" | sudo -S service ONodeREDUser start')
            # self.fnLaunch(self.Launcher.launch_plugin_device.value,
            #               self.skip_plugin_device, True)
            # self.fnLaunch(self.Launcher.launch_laser_odom.value, self.skip_laser_odom, False)
            # self.fnLaunch(self.Launcher.launch_base.value, self.skip_core, True)

        elif self.current_mode == self.CurrentMode.ready_to_start.value:
            self.MatrixFlowController(self.matrixflow_state[0])
            # self.fnLaunch(self.Launcher.launch_base.value, self.skip_core, False)
            # self.fnLaunch(self.Launcher.launch_laser_odom.value, self.skip_laser_odom, True)

        elif self.current_mode == self.CurrentMode.fucn_1.value:
            rospy.loginfo(
                "[Matrix Launch control]: Now trigger for fucn_1 mauldocking")
            # goal = AutodockOperateGoal()
            # goal.order = 1
            # self.IR_Manual_Docking.send_goal(goal)

        elif self.current_mode == self.CurrentMode.reset.value:
            rospy.loginfo(
                "[Matrix Launch control]: Now trigger for reset io state and off motor control")
            # self.fnLaunch(self.Launcher.launch_base.value, self.skip_core, False)

            # self.IR_Manual_Docking.cancel_all_goals()
            # self.move_base.cancel_all_goals()
            # self.IR_Docking.cancel_all_goals()
            # self.IST_Docking.cancel_all_goals()
            # self.IST_RouteFollow.cancel_all_goals()
            # self.IST_Mission_server.cancel_all_goals()
            # self.IST_Mission_operate.cancel_all_goals()
            # self.ScanMotion.cancel_all_goals()
            # self.UVC.cancel_all_goals()

            # self.fnLaunch(self.Launcher.launch_mcu01_action.value, False)
            # self.fnLaunch(self.Launcher.launch_autodock.value, False)
            # self.fnLaunch(self.Launcher.launch_manual_docking.value, False)

            # self.fnLaunch(self.Launcher.launch_base.value, False)
            # self.fnLaunch(self.Launcher.launch_mcu01_action.value, False)
            # self.fnLaunch(self.Launcher.launch_autodock.value, False)

        elif self.current_mode == RobotMode.EMERGENCY:
            rospy.loginfo(
                "[Matrix Launch control]: Now trigger for Stop motor drive")
            # self.fnLaunch(self.Launcher.launch_localization.value, False)
            # rospy.sleep(5)
            # os.system('echo \"a\" | sudo -S ip link set can0 down')
            # self.fnLaunch(self.Launcher.launch_base.value, self.skip_core, False)
            # self.fnLaunch(self.Launcher.launch_laser_odom.value, self.skip_laser_odom, False)
            try:
                self.MatrixFlowController(self.matrixflow_state[2])
                # os.system('echo \"a\" | sudo -S service ONodeREDUser stop')
                media_playerSRV = rospy.ServiceProxy(
                    'media_player_server', MediaPlayer)
                srv_req = MediaPlayerRequest()

                srv_req.cmd = "clear"

                srv_res = media_playerSRV(srv_req)
            except:
                pass

            try:
                os.system('killall -9 vlc')
            except:
                pass

            # self.IR_Manual_Docking.cancel_all_goals()
            self.move_base.cancel_all_goals()
            self.serial_operation.cancel_all_goals()
            self.movement_operation.cancel_all_goals()
            self.artrack_operation.cancel_all_goals()
            self.swapenvi_operation.cancel_all_goals()
            self.docking_operation.cancel_all_goals()
            self.schedule_operation.cancel_all_goals()
            self.ar3mark_operation.cancel_all_goals()
            self.handlemat_operation.cancel_all_goals()
            self.ardocking_operation.cancel_all_goals()
            self.offcontrol_operation.cancel_all_goals()
            self.wallfollowing_operation.cancel_all_goals()
            self.cvshape_operation.cancel_all_goals()
            self.cvshape2dir_operation.cancel_all_goals()
            self.dockingmulti_operation.cancel_all_goals()

            # self.fnLaunch(self.Launcher.launch_plugin_device.value,
            #               self.skip_plugin_device, False)

            self.IST_Docking.cancel_all_goals()
            self.IST_RouteFollow.cancel_all_goals()

            # self.IR_Docking.cancel_all_goals()
            # self.IST_Docking.cancel_all_goals()
            # self.IST_RouteFollow.cancel_all_goals()
            # self.IST_Mission_server.cancel_all_goals()
            # self.IST_Mission_operate.cancel_all_goals()
            # self.ScanMotion.cancel_all_goals()
            # self.UVC.cancel_all_goals()

            # self.fnLaunch(self.Launcher.launch_mcu01_action.value, False)
            # self.fnLaunch(self.Launcher.launch_autodock.value, False)
            # self.fnLaunch(self.Launcher.launch_manual_docking.value, False)
            # a = subprocess.run(["rosservice", "call", "/matrix_io/led_status"])

            # elif self.current_mode == self.CurrentMode.fucn_1.value:
        #     rospy.loginfo("[Matrix Launch control]: Now trigger for Relocalization")
        #     self.fnLaunch(self.Launcher.launch_localization.value, False)
        #     rospy.sleep(5)
        #     self.fnLaunch(self.Launcher.launch_localization.value, True)

        elif self.current_mode == self.CurrentMode.down_stairs.value:
            rospy.loginfo(
                "[Matrix Launch control]: Now trigger for Down stairs")
            self.fnLaunch(self.Launcher.launch_base.value,
                          self.skip_core, False)

        elif self.current_mode == self.CurrentMode.tablet_loss_commu.value:
            rospy.loginfo(
                "[Matrix Launch control]: Now trigger for Tablet loss comunicate")
            # self.fnLaunch(self.Launcher.launch_base.value, self.skip_core, False)
            # self.move_base.cancel_all_goals()
            # self.IR_Docking.cancel_all_goals()
            # self.IST_Docking.cancel_all_goals()
            # self.IST_RouteFollow.cancel_all_goals()
            # self.IST_Mission_server.cancel_all_goals()
            # self.IST_Mission_operate.cancel_all_goals()
            # self.ScanMotion.cancel_all_goals()
            # self.UVC.cancel_all_goals()
            # self.fnLaunch(self.Launcher.launch_mcu01_action.value, False)

        elif self.current_mode == self.CurrentMode.emergency_charge.value:
            rospy.loginfo(
                "[Matrix Launch control]: Now trigger for emergency charge")
            # self.fnLaunch(self.Launcher.launch_base.value, self.skip_core, False)

            # self.move_base.cancel_all_goals()
            # self.IR_Docking.cancel_all_goals()
            # self.IST_Docking.cancel_all_goals()
            # self.IST_RouteFollow.cancel_all_goals()
            # self.IST_Mission_server.cancel_all_goals()
            # self.IST_Mission_operate.cancel_all_goals()
            # self.ScanMotion.cancel_all_goals()
            # self.UVC.cancel_all_goals()
            # self.fnLaunch(self.Launcher.launch_mcu01_action.value, False)

        # Off_robot mode
        elif self.current_mode == self.CurrentMode.shutdown_robot.value:
            rospy.loginfo("Now trigger for shutdown Robot")

            self.fnLaunch(self.Launcher.launch_tf.value, self.skip_tf, False)
            self.fnLaunch(self.Launcher.launch_lidar_front.value,
                          self.skip_lidar_f, False)
            self.fnLaunch(self.Launcher.launch_lidar_r.value,
                          self.skip_lidar_r, False)
            self.fnLaunch(self.Launcher.launch_sound.value,
                          self.skip_sound, False)
            self.fnLaunch(self.Launcher.launch_mcu01.value,
                          self.skip_mcu1, False)
            self.fnLaunch(self.Launcher.launch_mcu02.value,
                          self.skip_mcu2, False)
            self.fnLaunch(self.Launcher.launch_camera.value,
                          self.skip_camera, False)
            self.fnLaunch(self.Launcher.launch_bms_base.value,
                          self.skip_bms, False)
            self.fnLaunch(self.Launcher.launch_imu.value, self.skip_imu, False)
            self.fnLaunch(self.Launcher.launch_localization.value,
                          self.skip_localization, False)
            # self.fnLaunch(self.Launcher.launch_autodock.value, False)
            # self.fnLaunch(self.Launcher.launch_manual_docking.value, False)
            self.fnLaunch(self.Launcher.launch_movement_state.value,
                          self.skip_movement_state, False)
            # self.fnLaunch(self.Launcher.launch_dynamics_param.value, False)
            self.fnLaunch(self.Launcher.launch_diagnostics.value,
                          self.skip_diagnostics, False)
            # self.fnLaunch(self.Launcher.launch_vel_filter.value, False)
            self.fnLaunch(self.Launcher.launch_base.value,
                          self.skip_core, False)
            os.system("rosnode kill --all")
            os.system('echo \"a\" | sudo -S shutdown now')

        self.is_triggered = False

    def fnLaunch(self, launch_num, skip, is_start):

        # if launch_num == self.Launcher.launch_manual_docking.value:
        #     if is_start == True:
        #         if self.launch_manual_docking_launched == False:
        #             self.launch_manual_docking = roslaunch.scriptapi.ROSLaunch()
        #             self.launch_manual_docking = roslaunch.parent.ROSLaunchParent(self.uuid, [self.rospack.get_path('matrix_system') + "/launch/matrix_manualdock.launch"])
        #             self.launch_manual_docking_launched = True
        #             self.launch_manual_docking.start()
        #         else:
        #             pass
        #     else:
        #         if self.launch_manual_docking_launched == True:
        #             self.launch_manual_docking_launched = False
        #             self.launch_manual_docking.shutdown()
        #         else:
        #             pass

        if launch_num == self.Launcher.launch_aragorn_bridge.value:
