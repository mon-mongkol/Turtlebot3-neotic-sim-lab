    def init_canbus(self, can_device, bitrate):
        print ("[matrix_launch_controller]: Force down {}".format(can_device))
        os.system('echo \"a\" | sudo -S ip link set '+ can_device +' down')
        print("")
        # time.sleep(1.0)
        print ("[matrix_launch_controller]: Bringup {}".format(can_device))
        os.system('echo \"a\" | sudo -S ip link set '+ can_device +' up type can bitrate ' + str(bitrate))
        # time.sleep(0.5)
        # self.NMT_service(0x00, "Reset Node")
        # print("")
        print ("[matrix_launch_controller]: {} bringup success!!!".format(can_device))


    def cbModeLaunch(self, mode_msg):
        # rospy.loginfo("Start core_controller with mode %d", mode_msg)
        if (self.current_mode == mode_msg.robot_mode):
            pass
        else:
            self.current_mode = mode_msg.robot_mode
            self.is_triggered = True

