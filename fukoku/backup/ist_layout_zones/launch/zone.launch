<launch>

  <arg name="robot_zone" default="true"/>
  <group if="$(arg robot_zone)">
    <node name="ist_layout_zones" pkg="ist_layout_zones" type="ist_layout_zones_node" respawn="false" output="screen">
      
      <param name="map_frame" value="/map"/>
      <param name="base_frame" value="/base_footprint"/>
      <param name="is_check_footprint" value="true"/>
      <param name="footprint_topic" value="/move_base/global_costmap/footprint"/>

      <param name="publish_frequency" value="10"/>
    </node>

    <node name="ist_layout_poi" pkg="ist_layout_zones" type="ist_layout_poi_node" respawn="false" output="screen">
      
      <param name="map_frame" value="/map"/>
      <param name="base_frame" value="/base_footprint"/>
      <param name="is_check_footprint" value="true"/>
      <param name="footprint_topic" value="/move_base/global_costmap/footprint"/>

      <param name="publish_frequency" value="10"/>
    </node>
  </group>

</launch>