#! /usr/bin/env python
from __future__ import print_function
import rospkg
import rospy, roslaunch
import numpy as np
import subprocess
import os
import sys

import actionlib
import web_interface_msgs.msg
from web_launch_server.launchNode import LaunchNode
from web_launch_server.launchFile import LaunchFile



class WebLaunchAction(object):

    # create messages that are used to publish feedback/result
    _feedback = web_interface_msgs.msg.WebCommandFeedback()
    _result = web_interface_msgs.msg.WebCommandResult()
    rospack = rospkg.RosPack()
    ros_package_path = rospack.get_path('web_launch_srv').replace('/web_launch_srv', '')

    _start_process = False
    _launchList = { 
        'rqt_gui':
        {
            'pkg': 'rqt_gui',
            'path': ros_package_path + '/web_interface/launch/test.launch',
            'obj':None
        },
        'ist_slam':
        {
            'pkg': 'ist_slam_gmapping',
            'path': ros_package_path + '/aragorn_slam/launch/aragorn_gmapping.launch',
            'obj':None
        },
        'ist_map_server':
        {
            'pkg': 'ist_map_server',
            'path': ros_package_path + '/ist_map_server/launch/map_server.launch',
            'obj':None
        },
        'ist_map_saver':
        {
            'pkg': 'ist_map_server',
            'path': ros_package_path + '/ist_map_server/launch/save.launch',
            'obj' : None
        },
        'move_base':
        {
            'pkg': 'ist_map_server',
            'path': ros_package_path + '/ist_map_server/launch/move_base.launch',
            'obj' : None
        },

    }
    

    def __init__(self, name):
        self._action_name = name
        self._as = actionlib.SimpleActionServer(self._action_name, web_interface_msgs.msg.WebCommandAction, execute_cb=self.execute_cb, auto_start = False)
        #pkg = self.rospack.get_path('web_launch_srv')
        #self.ros_package_path = os.path.dirname(os.path.realpath(__file__))
        #self.ros_package_path = pkg.replace('/web_launch_srv', '')
        rospy.loginfo('Launch path:%s' % self.ros_package_path)
        rospy.loginfo('Create Object')
        for key,elem in self._launchList.items():
            #file = self.ros_package_path + elem['path'] 
            file = elem['path'] 
            rospy.loginfo('%s:%s' %(key,elem))
            elem['obj'] =  LaunchFile( key , elem['pkg'] , file)

        for key,elem in self._launchList.items():
            rospy.loginfo("%s completed:%s, isStart:%s"%(key,str(elem['obj'].isCompleted()), str(elem['obj'].isStated())))


        self._as.start()


    def execute_cb(self, goal):
        # helper variables
        r = rospy.Rate(1)
        success = True
        isCancel = False
        self._feedback.command = goal.command
        self._feedback.sequence = []
        key = goal.args[0]
        rospy.loginfo('web_launch_server:%s, key:%s args count:%d' % (goal.command, key, len(goal.args)))


        if(key in self._launchList.keys()):
            rospy.loginfo('%s:%s:%s' %(goal.command, key,self._launchList[key]['path']))
            self._launchList[key]['obj'].setCommand(goal.command,goal.args[1:])

        if(goal.command == 'list'):
            for key,elem in self._launchList.items():
                self._feedback.sequence.append(key + " path:" +  elem['path'])
                self._feedback.sequence.append(key + " completed:" + str(elem['obj'].isCompleted()) + " isStart:" + str(elem['obj'].isStated()))

        else:

            print ("Check for launch ..")

            for i,arg in enumerate(goal.args):
                if(arg in self._launchList.keys()):
                    if(self._launchList[arg]['obj'] != None):
                        while(not self._launchList[arg]['obj'].isCompleted() and not rospy.is_shutdown()):
                            rospy.loginfo("%s completed:%s, isStart:%s"%(arg,str(self._launchList[arg]['obj'].isCompleted()), str(self._launchList[arg]['obj'].isStated())))
                            # check that preempt has not been requested by the client
                            if self._as.is_preempt_requested():
                                rospy.loginfo('%s: Preempted' % self._action_name)
                                self._as.set_preempted()
                                isCancel = True
                                success = False
                                break
                            r.sleep()

                        self._feedback.sequence.append(arg + " completed:" + str(self._launchList[arg]['obj'].isCompleted()) + " isStart:" + str(self._launchList[arg]['obj'].isStated()))
                        # publish the feedback
                        self._as.publish_feedback(self._feedback)

                        if(isCancel == True):
                            break

        if success:
            strResult = 'Succeeded'
        else:
            strResult = 'Failed'
        self._result.command = self._feedback.command
        self._result.sequence = self._feedback.sequence
        rospy.loginfo('%s: %s' % (self._action_name,strResult))
        self._as.set_succeeded(self._result)
    

    def process(self):

        for elem in self._launchList.values():
            elem['obj'].doCommand()
                    
        pass


if __name__ == '__main__':
    rospy.init_node('web_launch_server')
    server = WebLaunchAction('web_launch_server')
    r = rospy.Rate(1)
    try:
        while not rospy.is_shutdown():
            server.process()
            r.sleep()
    except KeyboardInterrupt :
        print ("Shutting Down")

