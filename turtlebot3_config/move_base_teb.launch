<!-- ============================================================
     move_base_teb.launch
     Launch move_base with TEB Local Planner for TurtleBot3
     ============================================================ -->
<launch>
  <!-- Arguments -->
  <arg name="model"    default="$(env TURTLEBOT3_MODEL)" doc="burger / waffle / waffle_pi"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="odom_topic"    default="odom"/>
  <arg name="move_forward_only" default="false"/>


  <!-- move_base node -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
  <!-- All SBPLLatticePlanner parameters are loaded from the YAML config above. -->
    <param name="base_global_planner" value="SBPLLatticePlanner" />
    <param name="SBPLLatticePlanner/primitive_filename" value="/root/turtlebot3_config/tb3_0_05.mprim" />
    <rosparam file="$(find sbpl_lattice_planner)/launch/move_base/sbpl_global_params.yaml" command="load" />
    <rosparam file="$(find sbpl_lattice_planner)/launch/move_base/base_local_planner_params_close.yaml" command="load" />
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <rosparam file="$(env HOME)/turtlebot3_config/costmap_common_params_$(arg model).yaml" command="load" ns="global_costmap" />
    <rosparam file="$(env HOME)/turtlebot3_config/costmap_common_params_$(arg model).yaml" command="load" ns="local_costmap" />
    <rosparam file="$(env HOME)/turtlebot3_config/local_costmap_params.yaml" command="load" />
    <rosparam file="$(env HOME)/turtlebot3_config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(env HOME)/turtlebot3_config/move_base_params.yaml" command="load" />
    <rosparam file="$(env HOME)/turtlebot3_config/teb_local_planner_params.yaml" command="load" />
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
  </node>
</launch>
